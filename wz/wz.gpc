#pragma METAINFO("WZ Core", 0, 4, "Zaufanys")

/*
    WZ Core v0.4
    Native Titan Two / GPC2 foundation for Call of Duty: Warzone.

    Default controller mapping:
      FIRE       BUTTON_5   RT / R2
      ADS        BUTTON_8   LT / L2
      SPRINT     BUTTON_9   LS / L3
      JUMP       BUTTON_16  A / Cross
      STANCE     BUTTON_15  B / Circle
      SWAP/PLATE BUTTON_14  Y / Triangle
      USE/RELOAD BUTTON_17  X / Square

    Runtime controls:
      ADS + D-Pad Right : next recoil profile
      ADS + D-Pad Left  : previous recoil profile
      ADS + D-Pad Down  : toggle Context Lock
      D-Pad Up + Use    : guarded revive hold, when enabled/GCV-confirmed

    Context Lock disables movement and action helpers. Use it before Buy
    Stations, loadout menus, inventory screens, or other shared-input UI.
*/

#define FIRE            BUTTON_5
#define ADS             BUTTON_8
#define SPRINT          BUTTON_9
#define JUMP            BUTTON_16
#define STANCE          BUTTON_15
#define SWAP_PLATE      BUTTON_14
#define USE_RELOAD      BUTTON_17
#define DPAD_UP         BUTTON_10
#define DPAD_DOWN       BUTTON_11
#define DPAD_LEFT       BUTTON_12
#define DPAD_RIGHT      BUTTON_13
#define LOOK_X          STICK_1_X
#define LOOK_Y          STICK_1_Y
#define MOVE_X          STICK_2_X
#define MOVE_Y          STICK_2_Y

// Persistent-memory layout. Keep these offsets synchronized with cfgdesc.
#define PM_MASTER                   0
#define PM_PROFILE                  1
#define PM_AIM_MODE                 2
#define PM_AIM_ACTIVATION           3
#define PM_AIM_RADIUS               4
#define PM_AIM_INTERVAL             8
#define PM_AIM_DEADZONE            12
#define PM_ROTATIONAL              16
#define PM_ROTATIONAL_RADIUS       20
#define PM_ROTATIONAL_INTERVAL     24
#define PM_AR_ENABLE               28
#define PM_AR_BOOST_MS             32
#define PM_P1_VERTICAL             36
#define PM_P1_HORIZONTAL           40
#define PM_P1_BOOST                44
#define PM_P2_VERTICAL             48
#define PM_P2_HORIZONTAL           52
#define PM_P2_BOOST                56
#define PM_P3_VERTICAL             60
#define PM_P3_HORIZONTAL           64
#define PM_P3_BOOST                68
#define PM_SPRINT_ENABLE           72
#define PM_SPRINT_MODE             73
#define PM_SLIDE_MODE              74
#define PM_SNAKE_ENABLE            75
#define PM_SLIDE_DELAY             76
#define PM_SNAKE_STRENGTH          80
#define PM_SNAKE_INTERVAL          84
#define PM_LOOT_ENABLE             88
#define PM_LOOT_ACTIVATION         89
#define PM_PLATE_ENABLE            90
#define PM_PARACHUTE_ENABLE        91
#define PM_LOOT_HOLD_MS            92
#define PM_PLATE_HOLD_MS           96
#define PM_PARACHUTE_FREEFALL_MS  100
#define PM_CONTEXT_LOCK_DEFAULT   104
#define PM_GCV_ENABLE             105
#define PM_GCV_AUTO_PROFILE       106
#define PM_GCV_CONTEXT_GUARD      107
#define PM_GCV_STALE_MS           108
#define PM_GCV_MIN_CONFIDENCE     112
#define PM_SPRINT_REFRESH_MS      116
#define PM_REVIVE_ENABLE          120
#define PM_REVIVE_HOLD_MS         124
#define PM_RUMBLE_HINT_ENABLE     128
#define PM_RUMBLE_LOW             152
#define PM_RUMBLE_HIGH            156
#define PM_RUMBLE_PROFILE         131
#define PM_RUMBLE_CONFIRM_MS      132
#define PM_SPRINT_THRESHOLD       136
#define PM_ADS_RESPONSE_ENABLE    140
#define PM_ADS_RESPONSE_DEADZONE  144
#define PM_ADS_RESPONSE_SOFTNESS  148

#define GCV_MAGIC              0x575A
#define GCV_PROTOCOL_VERSION        1
#define GCV_UI_GAMEPLAY              0
#define GCV_UI_REVIVE                4
#define GCV_UI_PARACHUTE             5
#define GCV_UI_UNKNOWN             255
#define GCV_FLAG_TEMPLATES_READY  0x02
#define GCV_FLAG_WEAPON_KNOWN     0x08

uint8 master_enable = TRUE;
uint8 active_profile = 0;
uint8 aim_mode = 0;
uint8 aim_activation = 0;
fix32 aim_radius = 4.0;
uint32 aim_interval = 16;
fix32 aim_deadzone = 20.0;

uint8 rotational_enable = FALSE;
fix32 rotational_radius = 3.0;
uint32 rotational_interval = 40;

uint8 anti_recoil_enable = FALSE;
uint32 recoil_boost_ms = 120;
fix32 p1_vertical = 0.0;
fix32 p1_horizontal = 0.0;
fix32 p1_boost = 0.0;
fix32 p2_vertical = 0.0;
fix32 p2_horizontal = 0.0;
fix32 p2_boost = 0.0;
fix32 p3_vertical = 0.0;
fix32 p3_horizontal = 0.0;
fix32 p3_boost = 0.0;

uint8 sprint_enable = FALSE;
uint8 sprint_mode = 0;
uint8 slide_mode = 0;
uint8 snake_enable = FALSE;
uint32 slide_delay = 180;
fix32 snake_strength = 18.0;
uint32 snake_interval = 90;

uint8 loot_enable = FALSE;
uint8 loot_activation = 1;
uint8 plate_enable = FALSE;
uint8 parachute_enable = FALSE;
uint32 loot_hold_ms = 220;
uint32 plate_hold_ms = 2200;
uint32 parachute_freefall_ms = 600;
uint32 sprint_refresh_ms = 900;
fix32 sprint_threshold = 92.0;
uint8 revive_enable = FALSE;
uint32 revive_hold_ms = 4500;
uint8 rumble_hint_enable = FALSE;
fix32 rumble_low = 20.0;
fix32 rumble_high = 90.0;
uint8 rumble_profile = 0;
uint32 rumble_confirm_ms = 180;
uint8 context_lock_default = FALSE;
uint8 gcv_enable = FALSE;
uint8 gcv_auto_profile = FALSE;
uint8 gcv_context_guard = TRUE;
uint32 gcv_stale_ms = 100;
uint8 gcv_min_confidence = 82;

bool context_lock = FALSE;
bool fire_was_active = FALSE;
uint32 fire_time = 0;
uint32 aim_clock = 0;
uint32 rotational_clock = 0;
uint32 snake_clock = 0;
uint8 aim_phase = 0;
uint8 rotational_phase = 0;
int8 snake_direction = 1;
uint32 sprint_refresh_clock = 0;
bool sprint_latched = FALSE;
uint32 rumble_hint_clock = 0;
fix32 previous_look_x = 0.0;
fix32 previous_look_y = 0.0;
uint8 ads_response_enable = FALSE;
fix32 ads_response_deadzone = 2.5;
fix32 ads_response_softness = 45.0;

// GCV packet v1 (16 bytes, little-endian).
uint16 cv_magic = 0;
uint8 cv_version = 0;
uint8 cv_flags = 0;
uint16 cv_sequence = 0;
uint16 cv_process_ms = 0;
uint16 cv_capture_fps_x10 = 0;
uint8 cv_weapon_id = 0;
uint8 cv_optic_id = 0;
uint8 cv_ui_state = GCV_UI_UNKNOWN;
uint8 cv_confidence = 0;
uint8 cv_profile = 255;
uint8 cv_reserved = 0;
uint32 cv_age_ms = 60000;

init {
    pmem_load();

    pmem_read(PM_MASTER, &master_enable);
    pmem_read(PM_PROFILE, &active_profile);
    pmem_read(PM_AIM_MODE, &aim_mode);
    pmem_read(PM_AIM_ACTIVATION, &aim_activation);
    pmem_read(PM_AIM_RADIUS, &aim_radius);
    pmem_read(PM_AIM_INTERVAL, &aim_interval);
    pmem_read(PM_AIM_DEADZONE, &aim_deadzone);
    pmem_read(PM_ROTATIONAL, &rotational_enable);
    pmem_read(PM_ROTATIONAL_RADIUS, &rotational_radius);
    pmem_read(PM_ROTATIONAL_INTERVAL, &rotational_interval);
    pmem_read(PM_AR_ENABLE, &anti_recoil_enable);
    pmem_read(PM_AR_BOOST_MS, &recoil_boost_ms);
    pmem_read(PM_P1_VERTICAL, &p1_vertical);
    pmem_read(PM_P1_HORIZONTAL, &p1_horizontal);
    pmem_read(PM_P1_BOOST, &p1_boost);
    pmem_read(PM_P2_VERTICAL, &p2_vertical);
    pmem_read(PM_P2_HORIZONTAL, &p2_horizontal);
    pmem_read(PM_P2_BOOST, &p2_boost);
    pmem_read(PM_P3_VERTICAL, &p3_vertical);
    pmem_read(PM_P3_HORIZONTAL, &p3_horizontal);
    pmem_read(PM_P3_BOOST, &p3_boost);
    pmem_read(PM_SPRINT_ENABLE, &sprint_enable);
    pmem_read(PM_SPRINT_MODE, &sprint_mode);
    pmem_read(PM_SLIDE_MODE, &slide_mode);
    pmem_read(PM_SNAKE_ENABLE, &snake_enable);
    pmem_read(PM_SLIDE_DELAY, &slide_delay);
    pmem_read(PM_SNAKE_STRENGTH, &snake_strength);
    pmem_read(PM_SNAKE_INTERVAL, &snake_interval);
    pmem_read(PM_LOOT_ENABLE, &loot_enable);
    pmem_read(PM_LOOT_ACTIVATION, &loot_activation);
    pmem_read(PM_PLATE_ENABLE, &plate_enable);
    pmem_read(PM_PARACHUTE_ENABLE, &parachute_enable);
    pmem_read(PM_LOOT_HOLD_MS, &loot_hold_ms);
    pmem_read(PM_PLATE_HOLD_MS, &plate_hold_ms);
    pmem_read(PM_PARACHUTE_FREEFALL_MS, &parachute_freefall_ms);
    pmem_read(PM_SPRINT_REFRESH_MS, &sprint_refresh_ms);
    pmem_read(PM_SPRINT_THRESHOLD, &sprint_threshold);
    pmem_read(PM_ADS_RESPONSE_ENABLE, &ads_response_enable);
    pmem_read(PM_ADS_RESPONSE_DEADZONE, &ads_response_deadzone);
    pmem_read(PM_ADS_RESPONSE_SOFTNESS, &ads_response_softness);
    pmem_read(PM_REVIVE_ENABLE, &revive_enable);
    pmem_read(PM_REVIVE_HOLD_MS, &revive_hold_ms);
    pmem_read(PM_RUMBLE_HINT_ENABLE, &rumble_hint_enable);
    pmem_read(PM_RUMBLE_LOW, &rumble_low);
    pmem_read(PM_RUMBLE_HIGH, &rumble_high);
    pmem_read(PM_RUMBLE_PROFILE, &rumble_profile);
    pmem_read(PM_RUMBLE_CONFIRM_MS, &rumble_confirm_ms);
    pmem_read(PM_CONTEXT_LOCK_DEFAULT, &context_lock_default);
    pmem_read(PM_GCV_ENABLE, &gcv_enable);
    pmem_read(PM_GCV_AUTO_PROFILE, &gcv_auto_profile);
    pmem_read(PM_GCV_CONTEXT_GUARD, &gcv_context_guard);
    pmem_read(PM_GCV_STALE_MS, &gcv_stale_ms);
    pmem_read(PM_GCV_MIN_CONFIDENCE, &gcv_min_confidence);

    active_profile = clamp(active_profile, 0, 2);
    aim_mode = clamp(aim_mode, 0, 4);
    aim_activation = clamp(aim_activation, 0, 1);
    sprint_mode = clamp(sprint_mode, 0, 2);
    slide_mode = clamp(slide_mode, 0, 2);
    loot_activation = clamp(loot_activation, 0, 1);
    aim_radius = clamp(aim_radius, 0.0, 20.0);
    aim_interval = clamp(aim_interval, 4, 100);
    aim_deadzone = clamp(aim_deadzone, 0.0, 100.0);
    rotational_radius = clamp(rotational_radius, 0.0, 15.0);
    rotational_interval = clamp(rotational_interval, 10, 200);
    recoil_boost_ms = clamp(recoil_boost_ms, 0, 1000);
    p1_vertical = clamp(p1_vertical, -100.0, 100.0);
    p1_horizontal = clamp(p1_horizontal, -100.0, 100.0);
    p1_boost = clamp(p1_boost, -50.0, 50.0);
    p2_vertical = clamp(p2_vertical, -100.0, 100.0);
    p2_horizontal = clamp(p2_horizontal, -100.0, 100.0);
    p2_boost = clamp(p2_boost, -50.0, 50.0);
    p3_vertical = clamp(p3_vertical, -100.0, 100.0);
    p3_horizontal = clamp(p3_horizontal, -100.0, 100.0);
    p3_boost = clamp(p3_boost, -50.0, 50.0);
    slide_delay = clamp(slide_delay, 50, 600);
    snake_strength = clamp(snake_strength, 0.0, 50.0);
    snake_interval = clamp(snake_interval, 30, 500);
    loot_hold_ms = clamp(loot_hold_ms, 100, 1000);
    plate_hold_ms = clamp(plate_hold_ms, 500, 5000);
    parachute_freefall_ms = clamp(parachute_freefall_ms, 150, 2000);
    sprint_refresh_ms = clamp(sprint_refresh_ms, 400, 3000);
    sprint_threshold = clamp(sprint_threshold, 70.0, 100.0);
    ads_response_deadzone = clamp(ads_response_deadzone, 0.0, 20.0);
    ads_response_softness = clamp(ads_response_softness, 0.0, 100.0);
    revive_hold_ms = clamp(revive_hold_ms, 1000, 10000);
    rumble_low = clamp(rumble_low, 0.0, 100.0);
    rumble_high = clamp(rumble_high, rumble_low, 100.0);
    rumble_profile = clamp(rumble_profile, 0, 2);
    rumble_confirm_ms = clamp(rumble_confirm_ms, 40, 1000);
    gcv_stale_ms = clamp(gcv_stale_ms, 25, 1000);
    gcv_min_confidence = clamp(gcv_min_confidence, 0, 100);

    context_lock = context_lock_default;
}

main {
    // Runtime profile switching.
    if(is_active(ADS) && event_active(DPAD_RIGHT)) {
        active_profile = (active_profile + 1) % 3;
        save_profile();
        set_val(DPAD_RIGHT, 0.0);
    }
    if(is_active(ADS) && event_active(DPAD_LEFT)) {
        if(active_profile == 0) active_profile = 2;
        else active_profile--;
        save_profile();
        set_val(DPAD_LEFT, 0.0);
    }

    // Context Lock is the manual protection for shops, loadouts, inventory,
    // revives, reloads and other screens that share controller inputs.
    if(is_active(ADS) && event_active(DPAD_DOWN)) {
        context_lock = !context_lock;
        set_val(DPAD_DOWN, 0.0);
    }

    if(master_enable) {
        update_gcv_state();
        update_fire_timer();
        update_rumble_profile_hint();

        // ADS-only, output-side response shaping. It does not change the
        // physical TMR stick or add timing; it reduces near-centre response
        // before the other optional aim/recoil outputs are applied.
        if(ads_response_enable && is_active(ADS)) {
            apply_ads_response();
        }

        if(combat_aim_active()) {
            if(aim_mode) apply_aim_engine();
            if(rotational_enable) apply_rotational_engine();
        }

        if(anti_recoil_enable && is_active(ADS) && is_active(FIRE)) {
            apply_anti_recoil();
        }

        if(!context_lock) {
            run_movement_helpers();
        }
        else {
            combo_stop(AutoSprintPress);
            combo_stop(AutoSprintDoubleTap);
            sprint_refresh_clock = 0;
            sprint_latched = FALSE;
        }

        if(ReviveHold && !revive_continue_context()) {
            combo_stop(ReviveHold);
        }

        if(!action_context_blocked()) {
            run_action_helpers(TRUE);
        }
        else {
            combo_stop(LootPulse);
            combo_stop(PlateHold);
            combo_stop(ParachuteCycle);
            if(revive_helper_context()) {
                run_action_helpers(FALSE);
            }
            else {
                combo_stop(ReviveHold);
            }
        }

        previous_look_x = get_actual(LOOK_X);
        previous_look_y = get_actual(LOOK_Y);
    }
    else {
        reset_runtime();
    }
}

fix32 soften_ads_axis(fix32 value) {
    fix32 magnitude = abs(value);
    fix32 normalized = 0.0;
    fix32 squared = 0.0;
    fix32 output = 0.0;

    if(magnitude <= ads_response_deadzone) return 0.0;

    normalized = (magnitude - ads_response_deadzone) /
                 (100.0 - ads_response_deadzone);
    squared = normalized * normalized;
    output = normalized + ((squared - normalized) * ads_response_softness / 100.0);
    output = output * 100.0;

    if(value < 0.0) return -output;
    return output;
}

void apply_ads_response() {
    set_val(LOOK_X, soften_ads_axis(get_actual(LOOK_X)));
    set_val(LOOK_Y, soften_ads_axis(get_actual(LOOK_Y)));
    return;
}

void update_gcv_state() {
    if(gcv_enable && gcv_ready()) {
        gcv_read(0, &cv_magic);
        gcv_read(2, &cv_version);
        gcv_read(3, &cv_flags);
        gcv_read(4, &cv_sequence);
        gcv_read(6, &cv_process_ms);
        gcv_read(8, &cv_capture_fps_x10);
        gcv_read(10, &cv_weapon_id);
        gcv_read(11, &cv_optic_id);
        gcv_read(12, &cv_ui_state);
        gcv_read(13, &cv_confidence);
        gcv_read(14, &cv_profile);
        gcv_read(15, &cv_reserved);

        if(cv_magic == GCV_MAGIC && cv_version == GCV_PROTOCOL_VERSION) {
            cv_age_ms = 0;

            // Do not write PMEM for automatic weapon swaps. This avoids flash
            // wear and leaves the user's manually selected startup profile.
            if(gcv_auto_profile && (cv_flags & GCV_FLAG_WEAPON_KNOWN) &&
               cv_confidence >= gcv_min_confidence && cv_profile <= 2) {
                active_profile = cv_profile;
            }
            return;
        }
    }
    if(cv_age_ms < 60000) {
        cv_age_ms += elapsed_time();
    }
    return;
}

bool gcv_packet_fresh() {
    return gcv_enable && cv_magic == GCV_MAGIC &&
           cv_version == GCV_PROTOCOL_VERSION && cv_age_ms <= gcv_stale_ms;
}

bool action_context_blocked() {
    if(context_lock) return TRUE;

    // Fail safe for action helpers only. A stale/unknown CV frame never
    // suppresses the player's raw controller or the combat pipeline.
    if(gcv_enable && gcv_context_guard) {
        if(!gcv_packet_fresh()) return TRUE;
        if(!(cv_flags & GCV_FLAG_TEMPLATES_READY)) return TRUE;
        if(cv_ui_state != GCV_UI_GAMEPLAY && cv_ui_state != GCV_UI_PARACHUTE) {
            return TRUE;
        }
    }
    return FALSE;
}

bool revive_helper_context() {
    if(!revive_continue_context()) return FALSE;
    if(ReviveHold) return TRUE;
    return is_active(DPAD_UP) && is_active(USE_RELOAD);
}

bool revive_continue_context() {
    if(context_lock || !revive_enable) return FALSE;
    if(is_active(ADS) || is_active(FIRE)) return FALSE;
    if(gcv_enable && gcv_context_guard) {
        return gcv_packet_fresh() && (cv_flags & GCV_FLAG_TEMPLATES_READY) &&
               cv_ui_state == GCV_UI_REVIVE;
    }
    return TRUE;
}

void update_fire_timer() {
    if(is_active(FIRE)) {
        if(!fire_was_active) fire_time = 0;
        fire_time += elapsed_time();
        fire_was_active = TRUE;
    }
    else {
        fire_was_active = FALSE;
        fire_time = 0;
    }
    return;
}

void update_rumble_profile_hint() {
    fix32 sample = 0.0;

    if(!rumble_hint_enable || !is_active(ADS) || !is_active(FIRE)) {
        rumble_hint_clock = 0;
        return;
    }

    // Prefer the calibrated GCV weapon result when it is available. Rumble is a
    // fallback hint only because explosions, damage, and platform effects share
    // the same vibration channel.
    if(gcv_auto_profile && gcv_packet_fresh() && (cv_flags & GCV_FLAG_WEAPON_KNOWN) &&
       cv_confidence >= gcv_min_confidence) {
        rumble_hint_clock = 0;
        return;
    }

    sample = strongest_rumble();
    if(sample >= rumble_low && sample <= rumble_high) {
        rumble_hint_clock += elapsed_time();
        if(rumble_hint_clock >= rumble_confirm_ms) {
            active_profile = rumble_profile;
        }
    }
    else {
        rumble_hint_clock = 0;
    }
    return;
}

fix32 strongest_rumble() {
    fix32 a = ffb_get_actual(FFB_1, NULL);
    fix32 b = ffb_get_actual(FFB_2, NULL);
    fix32 rt = ffb_get_actual(FFB_3, NULL);
    fix32 lt = ffb_get_actual(FFB_4, NULL);
    fix32 strongest = a;

    if(b > strongest) strongest = b;
    if(rt > strongest) strongest = rt;
    if(lt > strongest) strongest = lt;
    return strongest;
}

bool combat_aim_active() {
    if(!is_active(ADS)) return FALSE;
    if(aim_activation && !is_active(FIRE)) return FALSE;
    return TRUE;
}

void apply_aim_engine() {
    fix32 dx = 0.0;
    fix32 dy = 0.0;
    fix32 rx = get_actual(LOOK_X);
    fix32 ry = get_actual(LOOK_Y);
    fix32 velocity = abs(rx - previous_look_x) + abs(ry - previous_look_y);
    fix32 radius = aim_radius;

    aim_clock += elapsed_time();
    if(aim_clock >= aim_interval) {
        aim_clock = 0;
        aim_phase = (aim_phase + 1) % 8;
    }

    // Preserve deliberate right-stick aim outside the configured release point.
    if(sqrt((rx * rx) + (ry * ry)) > aim_deadzone) return;

    // Velocity mode scales the same micro-pattern with physical stick speed.
    if(aim_mode == 3) radius += clamp(velocity * 0.18, 0.0, aim_radius);

    if(aim_mode == 2) {
        // Shake: alternating horizontal micro-input. Intentionally simple and
        // available for comparison; Polar/Sticky are the safer starting points.
        if(aim_phase & 1) dx = radius;
        else dx = -radius;
    }
    else if(aim_mode == 4) {
        // Sticky: a compact four-point pattern.
        switch(aim_phase % 4) {
            case 0: dx =  radius; break;
            case 1: dy =  radius; break;
            case 2: dx = -radius; break;
            case 3: dy = -radius; break;
        }
    }
    else {
        // Polar and Velocity: eight-point octagonal approximation.
        switch(aim_phase) {
            case 0: dx =  radius;              break;
            case 1: dx =  radius * 0.707; dy =  radius * 0.707; break;
            case 2:                    dy =  radius;              break;
            case 3: dx = -radius * 0.707; dy =  radius * 0.707; break;
            case 4: dx = -radius;              break;
            case 5: dx = -radius * 0.707; dy = -radius * 0.707; break;
            case 6:                    dy = -radius;              break;
            case 7: dx =  radius * 0.707; dy = -radius * 0.707; break;
        }
    }

    offset_axis(LOOK_X, dx);
    offset_axis(LOOK_Y, dy);
    return;
}

void apply_rotational_engine() {
    fix32 lx = get_actual(MOVE_X);
    fix32 ly = get_actual(MOVE_Y);

    // Do not fight meaningful player movement.
    if(sqrt((lx * lx) + (ly * ly)) > 18.0) return;

    rotational_clock += elapsed_time();
    if(rotational_clock >= rotational_interval) {
        rotational_clock = 0;
        rotational_phase = (rotational_phase + 1) % 4;
    }

    switch(rotational_phase) {
        case 0: offset_axis(MOVE_X,  rotational_radius); break;
        case 1: offset_axis(MOVE_Y,  rotational_radius); break;
        case 2: offset_axis(MOVE_X, -rotational_radius); break;
        case 3: offset_axis(MOVE_Y, -rotational_radius); break;
    }
    return;
}

void apply_anti_recoil() {
    fix32 vertical = profile_vertical();
    fix32 horizontal = profile_horizontal();

    if(fire_time <= recoil_boost_ms) vertical += profile_boost();

    offset_axis(LOOK_X, horizontal);
    offset_axis(LOOK_Y, vertical);
    return;
}

fix32 profile_vertical() {
    if(active_profile == 1) return p2_vertical;
    if(active_profile == 2) return p3_vertical;
    return p1_vertical;
}

fix32 profile_horizontal() {
    if(active_profile == 1) return p2_horizontal;
    if(active_profile == 2) return p3_horizontal;
    return p1_horizontal;
}

fix32 profile_boost() {
    if(active_profile == 1) return p2_boost;
    if(active_profile == 2) return p3_boost;
    return p1_boost;
}

void offset_axis(uint8 axis, fix32 amount) {
    fix32 current = get_val(axis);
    set_val(axis, clamp(current + (amount * (100.0 - abs(current)) / 100.0), -100.0, 100.0));
    return;
}

void run_movement_helpers() {
    fix32 forward = get_actual(MOVE_Y);

    // Titan cannot raise Warzone's movement-speed cap. The refresh mode only
    // re-sends sprint input. In current Warzone, tactical sprint additionally
    // requires the Sprinter perk.
    if(sprint_enable && forward < -sprint_threshold &&
       !is_active(ADS) && !is_active(FIRE) &&
       !is_active(STANCE) && !is_active(USE_RELOAD) && !is_active(SWAP_PLATE)) {
        if(!sprint_latched) {
            sprint_latched = TRUE;
            sprint_refresh_clock = 0;
            if(sprint_mode == 0) combo_run(AutoSprintPress);
            else combo_run(AutoSprintDoubleTap);
        }
        else if(sprint_mode == 2) {
            sprint_refresh_clock += elapsed_time();
            if(sprint_refresh_clock >= sprint_refresh_ms &&
               !AutoSprintDoubleTap) {
                sprint_refresh_clock = 0;
                combo_run(AutoSprintDoubleTap);
            }
        }
    }
    else {
        combo_stop(AutoSprintPress);
        combo_stop(AutoSprintDoubleTap);
        sprint_refresh_clock = 0;
        sprint_latched = FALSE;
    }

    if(slide_mode && event_active(STANCE) && forward < -35.0) {
        if(slide_mode == 1) combo_run(SlideJump);
        else combo_run(SlideStand);
    }

    // Keep the user's original Snake idea as an explicit hold chord.
    if(snake_enable && is_active(DPAD_DOWN) && is_active(STANCE)) {
        snake_clock += elapsed_time();
        if(snake_clock >= snake_interval) {
            snake_clock = 0;
            snake_direction = -snake_direction;
        }
        if(snake_direction > 0) offset_axis(MOVE_X, snake_strength);
        else offset_axis(MOVE_X, -snake_strength);
        set_val(DPAD_DOWN, 0.0);
        set_val(STANCE, 0.0);
    }
    else {
        snake_clock = 0;
    }
    return;
}

void run_action_helpers(bool standard_actions_allowed) {
    bool action_chord = is_active(DPAD_LEFT);
    bool revive_chord = is_active(DPAD_UP);

    // Only the explicit D-Pad Left chord is supported. Suppress the physical
    // shared input from the first frame so the threshold cannot start a reload,
    // shop hold, or loadout interaction before the helper begins pulsing.
    if(standard_actions_allowed && loot_enable && loot_activation == 1 &&
       action_chord && is_active(USE_RELOAD) &&
       !is_active(ADS) && !is_active(FIRE)) {
        set_val(DPAD_LEFT, 0.0);
        set_val(USE_RELOAD, 0.0);
        if(time_active(USE_RELOAD) >= loot_hold_ms) combo_run(LootPulse);
        else combo_stop(LootPulse);
    }
    else {
        combo_stop(LootPulse);
    }

    // Plate Hold Assist is an accessibility-style hold. Set Warzone's Armor
    // Plate Behavior to Apply All first; that native setting is preferred.
    if(standard_actions_allowed && plate_enable &&
       action_chord && event_active(SWAP_PLATE)) {
        combo_run(PlateHold);
        set_val(DPAD_LEFT, 0.0);
    }

    // Manual parachute cut/redeploy cycle. No airborne state exists in normal
    // controller data, so this requires the explicit D-Pad Left + Jump chord.
    if(standard_actions_allowed && parachute_enable &&
       action_chord && event_active(JUMP) &&
       (!gcv_enable || !gcv_context_guard ||
        (gcv_packet_fresh() && (cv_flags & GCV_FLAG_TEMPLATES_READY) &&
         cv_ui_state == GCV_UI_PARACHUTE))) {
        combo_run(ParachuteCycle);
        set_val(DPAD_LEFT, 0.0);
        set_val(JUMP, 0.0);
    }

    // Quick Revive Hold Assist holds the normal revive/interact input. It does
    // not shorten any server-side timer.
    if(revive_enable && revive_chord && event_active(USE_RELOAD) &&
       revive_continue_context()) {
        combo_run(ReviveHold);
        set_val(DPAD_UP, 0.0);
        set_val(USE_RELOAD, 0.0);
    }
    return;
}

void save_profile() {
    pmem_write(PM_PROFILE, active_profile);
    pmem_save();
    printf("GCMD:InteractiveConfiguration.Refresh");
    return;
}

void reset_runtime() {
    combo_stop(AutoSprintPress);
    combo_stop(AutoSprintDoubleTap);
    combo_stop(SlideJump);
    combo_stop(SlideStand);
    combo_stop(LootPulse);
    combo_stop(PlateHold);
    combo_stop(ParachuteCycle);
    combo_stop(ReviveHold);
    fire_was_active = FALSE;
    fire_time = 0;
    aim_clock = 0;
    rotational_clock = 0;
    snake_clock = 0;
    sprint_refresh_clock = 0;
    sprint_latched = FALSE;
    rumble_hint_clock = 0;
    cv_age_ms = 60000;
    return;
}

combo AutoSprintPress {
    set_val(SPRINT, 100.0);
    wait(60);
    set_val(SPRINT, 0.0);
    wait(180);
}

combo AutoSprintDoubleTap {
    set_val(SPRINT, 100.0);
    wait(45);
    set_val(SPRINT, 0.0);
    wait(45);
    set_val(SPRINT, 100.0);
    wait(45);
    set_val(SPRINT, 0.0);
    wait(180);
}

combo SlideJump {
    set_val(STANCE, 100.0);
    wait(55);
    set_val(STANCE, 0.0);
    wait(slide_delay);
    set_val(JUMP, 100.0);
    wait(55);
    set_val(JUMP, 0.0);
    wait(120);
}

combo SlideStand {
    set_val(STANCE, 100.0);
    wait(55);
    set_val(STANCE, 0.0);
    wait(slide_delay);
    set_val(STANCE, 100.0);
    wait(55);
    set_val(STANCE, 0.0);
    wait(120);
}

combo LootPulse {
    set_val(USE_RELOAD, 100.0);
    wait(45);
    set_val(USE_RELOAD, 0.0);
    wait(55);
}

combo PlateHold {
    set_val(SWAP_PLATE, 100.0);
    wait(plate_hold_ms);
    set_val(SWAP_PLATE, 0.0);
    wait(80);
}

combo ParachuteCycle {
    set_val(STANCE, 100.0);
    wait(55);
    set_val(STANCE, 0.0);
    wait(parachute_freefall_ms);
    set_val(JUMP, 100.0);
    wait(55);
    set_val(JUMP, 0.0);
    wait(120);
}

combo ReviveHold {
    set_val(USE_RELOAD, 100.0);
    wait(revive_hold_ms);
    set_val(USE_RELOAD, 0.0);
    wait(80);
}

