define AUTOSPRINT_THRESHOLD_MAX     = 90;
define AUTOSPRINT_DELAY_DEFAULT     = 100; // Activation delay
define AUTOSPRINT_DELAY_MIN         = 50;
define AUTOSPRINT_DELAY_MAX         = 200;

// Persistent Memory Slots (0-79 available)
define PMEM_INITIALIZED   = 0;
define PMEM_FEAT_START    = 1;   // Slots 1-8: Feature enables
define PMEM_MODE_START    = 9;   // Slots 9-16: Activation modes
define PMEM_KEY1_START    = 17;  // Slots 17-24: Primary keys
define PMEM_KEY2_START    = 25;  // Slots 25-32: Secondary keys
