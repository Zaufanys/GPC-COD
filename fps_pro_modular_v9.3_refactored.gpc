define PMEM_WEAPSWAP_I    = 44;  // Weapon swap interval
define PMEM_AUTOSPRINT_T  = 45;  // Auto sprint threshold
define PMEM_AUTOSPRINT_D  = 46;  // Auto sprint delay

// LED Color Codes (RGB 0-100 scale)
define LED_BLUE_R         = 0;
define LED_BLUE_G         = 0;
define LED_BLUE_B         = 100;
define LED_CYAN_R         = 0;
define LED_CYAN_G         = 100;
define LED_CYAN_B         = 100;
define LED_GREEN_R        = 0;
define LED_GREEN_G        = 100;
define LED_GREEN_B        = 0;
define LED_ORANGE_R       = 100;
define LED_ORANGE_G       = 50;
define LED_ORANGE_B       = 0;
define LED_YELLOW_R       = 100;
define LED_YELLOW_G       = 100;
define LED_YELLOW_B       = 0;
define LED_OFF_R          = 0;
define LED_OFF_G          = 0;
define LED_OFF_B          = 0;

//=============================================================================
// SECTION 2: VARIABLE DECLARATIONS
//=============================================================================

// ===== Feature Control Arrays =====
int feat_enabled[TOTAL_FEATURES];       // ON/OFF state
int feat_mode[TOTAL_FEATURES];          // Activation mode
int feat_key_primary[TOTAL_FEATURES];   // Main activation key
int feat_key_secondary[TOTAL_FEATURES]; // Optional second key
int feat_active[TOTAL_FEATURES];        // Currently active?
int feat_toggle_state[TOTAL_FEATURES];  // Toggle mode state
int feat_timer[TOTAL_FEATURES];         // General purpose timer
int feat_step[TOTAL_FEATURES];          // State machine step counter

// ===== Combo Execution Guards =====
int combo_last_exec[TOTAL_FEATURES];    // Time since last execution
int combo_cooldown[TOTAL_FEATURES];     // Cooldown duration

// ===== Anti-Recoil Parameters =====
int cfg_recoil_vertical;      // Vertical compensation (0-100)
int cfg_recoil_horizontal;    // Horizontal compensation (-20-20)
int cfg_recoil_rate;          // Application speed

// ===== Movement Reset Parameters =====
int cfg_moverest_sprint_time; // Sprint duration
int cfg_moverest_cancel_time; // Cancel animation time

// ===== Snaking Parameters =====
int cfg_snaking_cycle_time;   // Time between stance changes

// ===== Wall Bounce Parameters =====
int cfg_wallbounce_jump_time; // Jump hold duration
int cfg_wallbounce_delay_time; // Delay between jumps

// ===== Drop Shot Parameters =====
int cfg_dropshot_prone_time;  // Prone activation time

// ===== Bunny Hop Parameters =====
int cfg_bunnyhop_jump_time;   // Jump tap duration
int cfg_bunnyhop_interval;    // Time between jumps

// ===== Weapon Swap Parameters =====
int cfg_weapswap_press_time;  // Y button press duration
int cfg_weapswap_interval;    // Time between swaps

// ===== Auto Sprint Parameters =====
int cfg_autosprint_threshold; // Stick threshold to activate
int cfg_autosprint_delay;     // Delay before sprint activates

// ===== Menu System Variables =====
int menu_state;               // MENU_OPEN or MENU_CLOSED
int menu_index;               // Current menu option
int menu_max_index;           // Total menu items
int menu_nav_timer;           // Navigation debounce timer

// ===== LED & Display Variables =====
int led_timer;                // LED blink timer
int led_state;                // LED on/off state
int oled_update_timer;        // OLED refresh timer

// ===== Utility Variables =====
int i;                        // Loop counter
int temp_val;                 // Temporary value holder

//=============================================================================
// SECTION 3: INITIALIZATION
//=============================================================================

/**
 * init - System initialization entry point
 *
 * Initializes all features, loads persistent settings, and prepares
 * the script for execution. Runs once on device boot or script load.
 */
init {
    // Check if persistent memory is initialized
    if(pmem_read(PMEM_INITIALIZED) != 42) {
        // First run - initialize with defaults
        init_default_config();
        pmem_write(PMEM_INITIALIZED, 42);
        save_config();
    } else {
        // Load saved settings
        load_config();
    }

    // Validate all parameters are within acceptable ranges
    validate_all_config();

    // Initialize feature runtime state
    init_feature_state();

    // Set initial LED status (Blue = Ready)
    set_led_ready();
}

/**
 * init_feature_state - Initialize runtime feature state
 *
 * Resets all feature timers, states, and execution guards to default.
 * Called during system initialization.
 */
function init_feature_state() {
    for(i = 0; i < TOTAL_FEATURES; i++) {
        feat_active[i] = FALSE;
        feat_toggle_state[i] = FALSE;
        feat_timer[i] = 0;
        feat_step[i] = 0;
        combo_last_exec[i] = 0;
        combo_cooldown[i] = TIMING_COMBO_COOLDOWN;
    }
}

//=============================================================================
// SECTION 4: MAIN LOOP
//=============================================================================

/**
 * main - Main execution loop
 *
 * Runs every frame (~1ms at 1000Hz). Handles menu activation,
 * processes features or menu, and updates feedback systems.
 */
main {
    // Menu activation: SELECT + DPAD_UP held for 300ms
    if(event_release(BTN_SELECT) && check_button_held(BTN_DPAD_UP, 300)) {
        toggle_menu();
    }

    // Process menu or game features
    if(menu_state == MENU_OPEN) {
        process_menu();
    } else {
        process_all_features();
    }

    // Update feedback systems
    update_led_feedback();
    update_combo_cooldowns();
}

//=============================================================================
// SECTION 5: FEATURE PROCESSING
//=============================================================================

/**
 * process_all_features - Main feature processing dispatcher
 *
 * Checks activation status for all enabled features and executes
 * those that are currently active. Features are only processed
 * if enabled to minimize overhead.
 */
function process_all_features() {
    // Check activation for enabled features
    for(i = 0; i < TOTAL_FEATURES; i++) {
        if(feat_enabled[i]) {
            check_feature_activation(i);
        } else {
            feat_active[i] = FALSE; // Ensure disabled features stay inactive
        }
    }

    // Execute active features
    if(feat_active[FEAT_ANTIRECOIL]) execute_antirecoil();
    if(feat_active[FEAT_MOVEREST]) execute_movement_reset();
    if(feat_active[FEAT_SNAKING]) execute_snaking();
    if(feat_active[FEAT_WALLBOUNCE]) execute_wallbounce();
    if(feat_active[FEAT_DROPMSHOT]) execute_dropshot();
    if(feat_active[FEAT_BUNNYHOP]) execute_bunnyhop();
    if(feat_active[FEAT_WEAPSWAP]) execute_weaponswap();
    if(feat_active[FEAT_AUTOSPRINT]) execute_autosprint();
}

/**
 * check_feature_activation - Determine if feature should be active
 * @param feat_idx: Index of feature to check (FEAT_*)
 *
 * Implements four activation modes:
 * - MODE_HOLD: Active while keys held
 * - MODE_TOGGLE: Press to enable/disable with debounce
 * - MODE_LONGPRESS: Requires long press to activate
 * - MODE_CONDITIONAL: Requires keys + ADS active
 */
function check_feature_activation(int feat_idx) {
    int key1 = is_key_active(feat_key_primary[feat_idx]);
    int key2 = TRUE;

    // Check secondary key if defined
    if(feat_key_secondary[feat_idx] != KEY_NONE) {
        key2 = is_key_active(feat_key_secondary[feat_idx]);
    }

    // Process based on activation mode
    if(feat_mode[feat_idx] == MODE_HOLD) {
        feat_active[feat_idx] = (key1 && key2);
        return;
    }

    if(feat_mode[feat_idx] == MODE_TOGGLE) {
        if(key1 && key2) {
            if(feat_timer[feat_idx] == 0) {
                feat_toggle_state[feat_idx] = !feat_toggle_state[feat_idx];
                feat_timer[feat_idx] = 300; // Debounce
            }
        }
        feat_active[feat_idx] = feat_toggle_state[feat_idx];
        return;
    }

    if(feat_mode[feat_idx] == MODE_LONGPRESS) {
        if(key1 && key2) {
            if(feat_timer[feat_idx] < TIMING_LONGPRESS) {
                feat_timer[feat_idx] += get_rtime();
            } else {
                feat_active[feat_idx] = TRUE;
            }
        } else {
            feat_timer[feat_idx] = 0;
            feat_active[feat_idx] = FALSE;
        }
        return;
    }

    if(feat_mode[feat_idx] == MODE_CONDITIONAL) {
        int ads_active = get_val(BTN_LT) > 50;
        feat_active[feat_idx] = (key1 && key2 && ads_active);
        return;
    }
}

/**
 * is_key_active - Check if a key/button is currently pressed
 * @param key_idx: Key index (KEY_*)
 * @return: TRUE if pressed, FALSE otherwise
 *
 * Maps abstract key indices to actual button states.
 * Triggers use threshold detection (>50), buttons use binary state.
 */
function is_key_active(int key_idx) {
    if(key_idx == KEY_RT) return get_val(BTN_RT) > 50;
    if(key_idx == KEY_LT) return get_val(BTN_LT) > 50;
    if(key_idx == KEY_RB) return get_val(BTN_RB);
    if(key_idx == KEY_LB) return get_val(BTN_LB);
    if(key_idx == KEY_A) return get_val(BTN_A);
    if(key_idx == KEY_B) return get_val(BTN_B);
    if(key_idx == KEY_X) return get_val(BTN_X);
    if(key_idx == KEY_Y) return get_val(BTN_Y);
    if(key_idx == KEY_L3) return get_val(BTN_L3);
    if(key_idx == KEY_R3) return get_val(BTN_R3);
    return FALSE;
}

//=============================================================================
// SECTION 6: FEATURE IMPLEMENTATIONS
//=============================================================================

/**
 * execute_antirecoil - Apply recoil compensation to aim stick
 *
 * Adds vertical and horizontal compensation to right stick input
 * to counteract weapon recoil. Only active when firing (RT held).
 * Uses proportional adjustment based on configured strength.
 */
function execute_antirecoil() {
    // Apply vertical compensation (upward)
    if(cfg_recoil_vertical > 0) {
        temp_val = get_val(STICK_RY);
        temp_val += (cfg_recoil_vertical * cfg_recoil_rate) / 100;
        temp_val = clamp(temp_val, -100, 100);
        set_val(STICK_RY, temp_val);
    }

    // Apply horizontal compensation (left/right)
    if(cfg_recoil_horizontal != 0) {
        temp_val = get_val(STICK_RX);
        temp_val += (cfg_recoil_horizontal * cfg_recoil_rate) / 100;
        temp_val = clamp(temp_val, -100, 100);
        set_val(STICK_RX, temp_val);
    }
}

/**
 * execute_movement_reset - Slide cancel mechanism
 *
 * Three-step state machine:
 * Step 0: Initiate sprint (hold L3)
 * Step 1: Wait for sprint duration, then crouch-cancel
 * Step 2: Wait for cancel animation, then reset
 *
 * Uses feat_step[FEAT_MOVEREST] for state tracking.
 */
function execute_movement_reset() {
    int step = feat_step[FEAT_MOVEREST];

    if(step == 0) {
        set_val(BTN_L3, 100); // Activate sprint
        feat_timer[FEAT_MOVEREST] = cfg_moverest_sprint_time;
        feat_step[FEAT_MOVEREST] = 1;
        return;
    }

    if(step == 1 && feat_timer[FEAT_MOVEREST] <= 0) {
        if(combo_can_execute(FEAT_MOVEREST)) {
            combo_run(Combo_MovementReset);
            combo_mark_executed(FEAT_MOVEREST);
            feat_timer[FEAT_MOVEREST] = cfg_moverest_cancel_time;
            feat_step[FEAT_MOVEREST] = 2;
        }
        return;
    }

    if(step == 2 && feat_timer[FEAT_MOVEREST] <= 0) {
        feat_step[FEAT_MOVEREST] = 0;
        feat_active[FEAT_MOVEREST] = FALSE;
        if(feat_mode[FEAT_MOVEREST] == MODE_TOGGLE) {
            feat_toggle_state[FEAT_MOVEREST] = FALSE;
        }
    }
}

/**
 * execute_snaking - Prone cycling for evasive movement
 *
 * Cycles through: Crouch → Prone → Stand → Repeat
 * Uses feat_step[FEAT_SNAKING] to track current stance.
 * Timing controlled by cfg_snaking_cycle_time.
 */
function execute_snaking() {
    if(feat_timer[FEAT_SNAKING] > 0) return;
    if(!combo_can_execute(FEAT_SNAKING)) return;

    int step = feat_step[FEAT_SNAKING];

    if(step == 0) {
        combo_run(Combo_SnakingCrouch);
        feat_step[FEAT_SNAKING] = 1;
    } else if(step == 1) {
        combo_run(Combo_SnakingProne);
        feat_step[FEAT_SNAKING] = 2;
    } else {
        combo_run(Combo_SnakingStand);
        feat_step[FEAT_SNAKING] = 0;
    }

    combo_mark_executed(FEAT_SNAKING);
    feat_timer[FEAT_SNAKING] = cfg_snaking_cycle_time;
}

/**
 * execute_wallbounce - Jump cancel for wall bouncing
 *
 * Three-step state machine:
 * Step 0: Press jump
 * Step 1: Hold jump for configured duration
 * Step 2: Release and wait for delay before reset
 */
function execute_wallbounce() {
    int step = feat_step[FEAT_WALLBOUNCE];

    if(step == 0) {
        set_val(BTN_A, 100);
        feat_timer[FEAT_WALLBOUNCE] = cfg_wallbounce_jump_time;
        feat_step[FEAT_WALLBOUNCE] = 1;
        return;
    }

    if(step == 1 && feat_timer[FEAT_WALLBOUNCE] <= 0) {
        set_val(BTN_A, 0);
        combo_mark_executed(FEAT_WALLBOUNCE);
        feat_timer[FEAT_WALLBOUNCE] = cfg_wallbounce_delay_time;
        feat_step[FEAT_WALLBOUNCE] = 2;
        return;
    }

    if(step == 2 && feat_timer[FEAT_WALLBOUNCE] <= 0) {
        feat_step[FEAT_WALLBOUNCE] = 0;
        feat_active[FEAT_WALLBOUNCE] = FALSE;
        if(feat_mode[FEAT_WALLBOUNCE] == MODE_TOGGLE) {
            feat_toggle_state[FEAT_WALLBOUNCE] = FALSE;
        }
    }
}

/**
 * execute_dropshot - Instant prone while firing
 *
 * State-driven drop shot (no wait() calls):
 * Step 0: Initiate prone combo
 * Step 1: Wait for prone duration
 * Step 2: Complete and deactivate
 *
 * FIXED: Previous version used wait() in function (not allowed)
 */
function execute_dropshot() {
    int step = feat_step[FEAT_DROPMSHOT];

    if(step == 0) {
        if(combo_can_execute(FEAT_DROPMSHOT)) {
            combo_run(Combo_DropShot);
            combo_mark_executed(FEAT_DROPMSHOT);
            feat_timer[FEAT_DROPMSHOT] = cfg_dropshot_prone_time;
            feat_step[FEAT_DROPMSHOT] = 1;
        }
        return;
    }

    if(step == 1 && feat_timer[FEAT_DROPMSHOT] <= 0) {
        feat_step[FEAT_DROPMSHOT] = 0;
        feat_active[FEAT_DROPMSHOT] = FALSE;
        if(feat_mode[FEAT_DROPMSHOT] == MODE_TOGGLE) {
            feat_toggle_state[FEAT_DROPMSHOT] = FALSE;
        }
    }
}

/**
 * execute_bunnyhop - Auto jump while moving
 *
 * Only activates when player is moving (stick threshold check).
 * Executes jump combo at configured intervals.
 */
function execute_bunnyhop() {
    // Only jump when moving
    int is_moving = (abs(get_val(STICK_LY)) > BUNNYHOP_MOVE_THRESHOLD ||
                     abs(get_val(STICK_LX)) > BUNNYHOP_MOVE_THRESHOLD);

    if(!is_moving) return;
    if(feat_timer[FEAT_BUNNYHOP] > 0) return;
    if(!combo_can_execute(FEAT_BUNNYHOP)) return;

    combo_run(Combo_BunnyHop);
    combo_mark_executed(FEAT_BUNNYHOP);
    feat_timer[FEAT_BUNNYHOP] = cfg_bunnyhop_interval;
}

/**
 * execute_weaponswap - YY weapon swap
 *
 * Two-step state machine for double Y press:
 * Step 0: First Y press
 * Step 1: Wait interval, then second Y press
 * Step 2: Complete and deactivate
 */
function execute_weaponswap() {
    int step = feat_step[FEAT_WEAPSWAP];

    if(step == 0) {
        if(combo_can_execute(FEAT_WEAPSWAP)) {
            combo_run(Combo_WeaponSwap);
            combo_mark_executed(FEAT_WEAPSWAP);
            feat_timer[FEAT_WEAPSWAP] = cfg_weapswap_interval;
            feat_step[FEAT_WEAPSWAP] = 1;
        }
        return;
    }

    if(step == 1 && feat_timer[FEAT_WEAPSWAP] <= 0) {
        combo_run(Combo_WeaponSwap);
        combo_mark_executed(FEAT_WEAPSWAP);
        feat_step[FEAT_WEAPSWAP] = 0;
        feat_active[FEAT_WEAPSWAP] = FALSE;
        if(feat_mode[FEAT_WEAPSWAP] == MODE_TOGGLE) {
            feat_toggle_state[FEAT_WEAPSWAP] = FALSE;
        }
    }
}

/**
 * execute_autosprint - Automatic sprint on forward movement
 *
 * Activates sprint (L3) when left stick pushed forward beyond threshold.
 * Includes activation delay to prevent accidental triggering.
 */
function execute_autosprint() {
    int forward_input = get_val(STICK_LY);

    if(forward_input < -cfg_autosprint_threshold) {
        if(feat_timer[FEAT_AUTOSPRINT] <= 0) {
            set_val(BTN_L3, 100);
            feat_timer[FEAT_AUTOSPRINT] = cfg_autosprint_delay;
        }
    } else {
        feat_timer[FEAT_AUTOSPRINT] = 0;
    }
}

//=============================================================================
// SECTION 7: COMBO DEFINITIONS (Optimized, No Redundant Waits)
//=============================================================================

/**
 * Combo_MovementReset - Slide cancel crouch sequence
 * Double-tap crouch to cancel sprint animation
 */
combo Combo_MovementReset {
    set_val(BTN_B, 100);
    wait(MOVEREST_CROUCH_PRESS);
    set_val(BTN_B, 0);
    wait(MOVEREST_CROUCH_RELEASE);
    set_val(BTN_B, 100);
    wait(MOVEREST_CROUCH_PRESS);
    set_val(BTN_B, 0);
}

/**
 * Combo_SnakingCrouch - Single crouch tap
 */
combo Combo_SnakingCrouch {
    set_val(BTN_B, 100);
    wait(SNAKING_BTN_PRESS);
    set_val(BTN_B, 0);
}

/**
 * Combo_SnakingProne - Double-tap to prone
 */
combo Combo_SnakingProne {
    set_val(BTN_B, 100);
    wait(SNAKING_BTN_PRESS);
    set_val(BTN_B, 0);
    wait(SNAKING_BTN_PRESS);
    set_val(BTN_B, 100);
    wait(SNAKING_BTN_PRESS);
    set_val(BTN_B, 0);
}

/**
 * Combo_SnakingStand - Single tap to stand
 */
combo Combo_SnakingStand {
    set_val(BTN_B, 100);
    wait(SNAKING_BTN_PRESS);
    set_val(BTN_B, 0);
}

/**
 * Combo_DropShot - Quick prone sequence
 */
combo Combo_DropShot {
    set_val(BTN_B, 100);
    wait(DROPSHOT_BTN_PRESS);
    set_val(BTN_B, 0);
    wait(DROPSHOT_BTN_PRESS);
    set_val(BTN_B, 100);
    wait(DROPSHOT_BTN_PRESS);
    set_val(BTN_B, 0);
}

/**
 * Combo_BunnyHop - Quick jump tap
 */
combo Combo_BunnyHop {
    set_val(BTN_A, 100);
    wait(cfg_bunnyhop_jump_time);
    set_val(BTN_A, 0);
}

/**
 * Combo_WeaponSwap - Y button press
 */
combo Combo_WeaponSwap {
    set_val(BTN_Y, 100);
    wait(cfg_weapswap_press_time);
    set_val(BTN_Y, 0);
}

//=============================================================================
// SECTION 8: EXECUTION GUARDS (Spam Prevention)
//=============================================================================

/**
 * combo_can_execute - Check if combo cooldown has expired
 * @param feat_idx: Feature index
 * @return: TRUE if combo can execute, FALSE if still cooling down
 */
function combo_can_execute(int feat_idx) {
    return combo_last_exec[feat_idx] <= 0;
}

/**
 * combo_mark_executed - Mark combo as executed and set cooldown
 * @param feat_idx: Feature index
 */
function combo_mark_executed(int feat_idx) {
    combo_last_exec[feat_idx] = combo_cooldown[feat_idx];
}

/**
 * update_combo_cooldowns - Decrement all active cooldown timers
 * Called every frame from main loop
 */
function update_combo_cooldowns() {
    int delta = get_rtime();

    for(i = 0; i < TOTAL_FEATURES; i++) {
        if(combo_last_exec[i] > 0) {
            combo_last_exec[i] -= delta;
            if(combo_last_exec[i] < 0) combo_last_exec[i] = 0;
        }

        if(feat_timer[i] > 0) {
            feat_timer[i] -= delta;
            if(feat_timer[i] < 0) feat_timer[i] = 0;
        }
    }

    // Decrement menu navigation timer
    if(menu_nav_timer > 0) {
        menu_nav_timer -= delta;
        if(menu_nav_timer < 0) menu_nav_timer = 0;
    }
}

//=============================================================================
// SECTION 9: MENU SYSTEM
//=============================================================================

/**
 * toggle_menu - Open or close configuration menu
 *
 * When opening: Resets menu index, sets LED to yellow
 * When closing: Validates parameters, saves config, sets LED to blue
 */
function toggle_menu() {
    if(menu_state == MENU_CLOSED) {
        menu_state = MENU_OPEN;
        menu_index = 0;
        set_led_menu();
    } else {
        menu_state = MENU_CLOSED;
        validate_all_config();
        save_config();
        set_led_ready();
    }
}

/**
 * process_menu - Handle menu navigation and value adjustment
 *
 * D-Pad controls:
 * - UP/DOWN: Navigate menu options
 * - LEFT/RIGHT: Adjust values
 * - SELECT: Exit and save
 */
function process_menu() {
    if(menu_nav_timer > 0) return;

    if(get_val(BTN_DPAD_DOWN)) {
        menu_index++;
        if(menu_index > menu_max_index) menu_index = 0;
        menu_nav_timer = TIMING_MENU_NAV;
    }

    if(get_val(BTN_DPAD_UP)) {
        menu_index--;
        if(menu_index < 0) menu_index = menu_max_index;
        menu_nav_timer = TIMING_MENU_NAV;
    }

    if(get_val(BTN_DPAD_LEFT)) {
        menu_adjust_value(-1);
        menu_nav_timer = TIMING_MENU_NAV;
    }

    if(get_val(BTN_DPAD_RIGHT)) {
        menu_adjust_value(1);
        menu_nav_timer = TIMING_MENU_NAV;
    }

    if(event_release(BTN_SELECT)) {
        toggle_menu();
    }
}

/**
 * menu_adjust_value - Adjust current menu option value
 * @param direction: -1 for decrease, +1 for increase
 *
 * Handles all menu options with proper range limits
 */
function menu_adjust_value(int dir) {
    // Anti-Recoil (0-4)
    if(menu_index == 0) feat_enabled[FEAT_ANTIRECOIL] = !feat_enabled[FEAT_ANTIRECOIL];
    else if(menu_index == 1) feat_mode[FEAT_ANTIRECOIL] = cycle(feat_mode[FEAT_ANTIRECOIL], 0, 3, dir);
    else if(menu_index == 2) feat_key_primary[FEAT_ANTIRECOIL] = cycle(feat_key_primary[FEAT_ANTIRECOIL], 0, 10, dir);
    else if(menu_index == 3) cfg_recoil_vertical = clamp(cfg_recoil_vertical + (dir * 5), RECOIL_VERT_MIN, RECOIL_VERT_MAX);
    else if(menu_index == 4) cfg_recoil_horizontal = clamp(cfg_recoil_horizontal + dir, RECOIL_HORIZ_MIN, RECOIL_HORIZ_MAX);

    // Movement Reset (5-9)
    else if(menu_index == 5) feat_enabled[FEAT_MOVEREST] = !feat_enabled[FEAT_MOVEREST];
    else if(menu_index == 6) feat_mode[FEAT_MOVEREST] = cycle(feat_mode[FEAT_MOVEREST], 0, 3, dir);
    else if(menu_index == 7) feat_key_primary[FEAT_MOVEREST] = cycle(feat_key_primary[FEAT_MOVEREST], 0, 10, dir);
    else if(menu_index == 8) cfg_moverest_sprint_time = clamp(cfg_moverest_sprint_time + (dir * 10), MOVEREST_SPRINT_MIN, MOVEREST_SPRINT_MAX);
    else if(menu_index == 9) cfg_moverest_cancel_time = clamp(cfg_moverest_cancel_time + (dir * 10), MOVEREST_CANCEL_MIN, MOVEREST_CANCEL_MAX);

    // Snaking (10-13)
    else if(menu_index == 10) feat_enabled[FEAT_SNAKING] = !feat_enabled[FEAT_SNAKING];
    else if(menu_index == 11) feat_mode[FEAT_SNAKING] = cycle(feat_mode[FEAT_SNAKING], 0, 3, dir);
    else if(menu_index == 12) feat_key_primary[FEAT_SNAKING] = cycle(feat_key_primary[FEAT_SNAKING], 0, 10, dir);
    else if(menu_index == 13) cfg_snaking_cycle_time = clamp(cfg_snaking_cycle_time + (dir * 10), SNAKING_CYCLE_MIN, SNAKING_CYCLE_MAX);

    // Wall Bounce (14-18)
    else if(menu_index == 14) feat_enabled[FEAT_WALLBOUNCE] = !feat_enabled[FEAT_WALLBOUNCE];
    else if(menu_index == 15) feat_mode[FEAT_WALLBOUNCE] = cycle(feat_mode[FEAT_WALLBOUNCE], 0, 3, dir);
    else if(menu_index == 16) feat_key_primary[FEAT_WALLBOUNCE] = cycle(feat_key_primary[FEAT_WALLBOUNCE], 0, 10, dir);
    else if(menu_index == 17) cfg_wallbounce_jump_time = clamp(cfg_wallbounce_jump_time + (dir * 10), WALLBOUNCE_JUMP_MIN, WALLBOUNCE_JUMP_MAX);
    else if(menu_index == 18) cfg_wallbounce_delay_time = clamp(cfg_wallbounce_delay_time + (dir * 10), WALLBOUNCE_DELAY_MIN, WALLBOUNCE_DELAY_MAX);

    // Drop Shot (19-22)
    else if(menu_index == 19) feat_enabled[FEAT_DROPMSHOT] = !feat_enabled[FEAT_DROPMSHOT];
    else if(menu_index == 20) feat_mode[FEAT_DROPMSHOT] = cycle(feat_mode[FEAT_DROPMSHOT], 0, 3, dir);
    else if(menu_index == 21) feat_key_primary[FEAT_DROPMSHOT] = cycle(feat_key_primary[FEAT_DROPMSHOT], 0, 10, dir);
    else if(menu_index == 22) cfg_dropshot_prone_time = clamp(cfg_dropshot_prone_time + (dir * 10), DROPSHOT_PRONE_MIN, DROPSHOT_PRONE_MAX);

    // Bunny Hop (23-27)
    else if(menu_index == 23) feat_enabled[FEAT_BUNNYHOP] = !feat_enabled[FEAT_BUNNYHOP];
    else if(menu_index == 24) feat_mode[FEAT_BUNNYHOP] = cycle(feat_mode[FEAT_BUNNYHOP], 0, 3, dir);
    else if(menu_index == 25) feat_key_primary[FEAT_BUNNYHOP] = cycle(feat_key_primary[FEAT_BUNNYHOP], 0, 10, dir);
    else if(menu_index == 26) cfg_bunnyhop_jump_time = clamp(cfg_bunnyhop_jump_time + (dir * 5), BUNNYHOP_JUMP_MIN, BUNNYHOP_JUMP_MAX);
    else if(menu_index == 27) cfg_bunnyhop_interval = clamp(cfg_bunnyhop_interval + (dir * 10), BUNNYHOP_INTERVAL_MIN, BUNNYHOP_INTERVAL_MAX);

    // Weapon Swap (28-32)
    else if(menu_index == 28) feat_enabled[FEAT_WEAPSWAP] = !feat_enabled[FEAT_WEAPSWAP];
    else if(menu_index == 29) feat_mode[FEAT_WEAPSWAP] = cycle(feat_mode[FEAT_WEAPSWAP], 0, 3, dir);
    else if(menu_index == 30) feat_key_primary[FEAT_WEAPSWAP] = cycle(feat_key_primary[FEAT_WEAPSWAP], 0, 10, dir);
    else if(menu_index == 31) cfg_weapswap_press_time = clamp(cfg_weapswap_press_time + (dir * 10), WEAPSWAP_PRESS_MIN, WEAPSWAP_PRESS_MAX);
    else if(menu_index == 32) cfg_weapswap_interval = clamp(cfg_weapswap_interval + (dir * 10), WEAPSWAP_INTERVAL_MIN, WEAPSWAP_INTERVAL_MAX);

    // Auto Sprint (33-35)
    else if(menu_index == 33) feat_enabled[FEAT_AUTOSPRINT] = !feat_enabled[FEAT_AUTOSPRINT];
    else if(menu_index == 34) cfg_autosprint_threshold = clamp(cfg_autosprint_threshold + (dir * 5), AUTOSPRINT_THRESHOLD_MIN, AUTOSPRINT_THRESHOLD_MAX);
    else if(menu_index == 35) cfg_autosprint_delay = clamp(cfg_autosprint_delay + (dir * 10), AUTOSPRINT_DELAY_MIN, AUTOSPRINT_DELAY_MAX);
}

//=============================================================================
// SECTION 10: VALIDATION SYSTEM
//=============================================================================

/**
 * validate_all_config - Ensure all parameters within valid ranges
 *
 * Clamps all configuration values to defined min/max ranges.
 * Called during init, config load, and menu exit.
 */
function validate_all_config() {
    // Recoil
    cfg_recoil_vertical = clamp(cfg_recoil_vertical, RECOIL_VERT_MIN, RECOIL_VERT_MAX);
    cfg_recoil_horizontal = clamp(cfg_recoil_horizontal, RECOIL_HORIZ_MIN, RECOIL_HORIZ_MAX);

    // Movement Reset
    cfg_moverest_sprint_time = clamp(cfg_moverest_sprint_time, MOVEREST_SPRINT_MIN, MOVEREST_SPRINT_MAX);
    cfg_moverest_cancel_time = clamp(cfg_moverest_cancel_time, MOVEREST_CANCEL_MIN, MOVEREST_CANCEL_MAX);

    // Snaking
    cfg_snaking_cycle_time = clamp(cfg_snaking_cycle_time, SNAKING_CYCLE_MIN, SNAKING_CYCLE_MAX);

    // Wall Bounce
    cfg_wallbounce_jump_time = clamp(cfg_wallbounce_jump_time, WALLBOUNCE_JUMP_MIN, WALLBOUNCE_JUMP_MAX);
    cfg_wallbounce_delay_time = clamp(cfg_wallbounce_delay_time, WALLBOUNCE_DELAY_MIN, WALLBOUNCE_DELAY_MAX);

    // Drop Shot
    cfg_dropshot_prone_time = clamp(cfg_dropshot_prone_time, DROPSHOT_PRONE_MIN, DROPSHOT_PRONE_MAX);

    // Bunny Hop
    cfg_bunnyhop_jump_time = clamp(cfg_bunnyhop_jump_time, BUNNYHOP_JUMP_MIN, BUNNYHOP_JUMP_MAX);
    cfg_bunnyhop_interval = clamp(cfg_bunnyhop_interval, BUNNYHOP_INTERVAL_MIN, BUNNYHOP_INTERVAL_MAX);

    // Weapon Swap
    cfg_weapswap_press_time = clamp(cfg_weapswap_press_time, WEAPSWAP_PRESS_MIN, WEAPSWAP_PRESS_MAX);
    cfg_weapswap_interval = clamp(cfg_weapswap_interval, WEAPSWAP_INTERVAL_MIN, WEAPSWAP_INTERVAL_MAX);

    // Auto Sprint
    cfg_autosprint_threshold = clamp(cfg_autosprint_threshold, AUTOSPRINT_THRESHOLD_MIN, AUTOSPRINT_THRESHOLD_MAX);
    cfg_autosprint_delay = clamp(cfg_autosprint_delay, AUTOSPRINT_DELAY_MIN, AUTOSPRINT_DELAY_MAX);

    // Activation modes and keys
    for(i = 0; i < TOTAL_FEATURES; i++) {
        feat_mode[i] = clamp(feat_mode[i], 0, 3);
        feat_key_primary[i] = clamp(feat_key_primary[i], 0, 10);
        feat_key_secondary[i] = clamp(feat_key_secondary[i], 0, 10);
    }
}

//=============================================================================
// SECTION 11: UTILITY FUNCTIONS
//=============================================================================

/**
 * cycle - Cycle value within range
 * @param current: Current value
 * @param min_val: Minimum value (inclusive)
 * @param max_val: Maximum value (inclusive)
 * @param dir: Direction (-1 or +1)
 * @return: New cycled value
 */
function cycle(int current, int min_val, int max_val, int dir) {
    current += dir;
    if(current > max_val) current = min_val;
    if(current < min_val) current = max_val;
    return current;
}

/**
 * clamp - Clamp value to range
 * @param value: Value to clamp
 * @param min_val: Minimum allowed
 * @param max_val: Maximum allowed
 * @return: Clamped value
 */
function clamp(int value, int min_val, int max_val) {
    if(value < min_val) return min_val;
    if(value > max_val) return max_val;
    return value;
}

/**
 * check_button_held - Check if button held for duration
 * @param button: Button to check
 * @param duration_ms: Required hold time in milliseconds
 * @return: TRUE if held long enough, FALSE otherwise
 */
function check_button_held(int button, int duration_ms) {
    return get_ptime(button) >= duration_ms;
}

//=============================================================================
// SECTION 12: LED FEEDBACK HELPERS (Platform-Specific I/O)
//=============================================================================

/**
 * set_led_ready - Set LED to ready state (blue)
 */
function set_led_ready() {
    led_set(LED_4, LED_BLUE_R, LED_BLUE_G, LED_BLUE_B, -1);
}

/**
 * set_led_menu - Set LED to menu state (yellow)
 */
function set_led_menu() {
    led_set(LED_4, LED_YELLOW_R, LED_YELLOW_G, LED_YELLOW_B, -1);
}

/**
 * set_led_active_one - Set LED for 1 active feature (cyan)
 */
function set_led_active_one() {
    led_set(LED_4, LED_CYAN_R, LED_CYAN_G, LED_CYAN_B, -1);
}

/**
 * set_led_active_two - Set LED for 2 active features (green)
 */
function set_led_active_two() {
    led_set(LED_4, LED_GREEN_R, LED_GREEN_G, LED_GREEN_B, -1);
}

/**
 * set_led_active_many - Set LED for 3+ active features (orange/blinking)
 * @param on: TRUE for on, FALSE for off (blink control)
 */
function set_led_active_many(int on) {
    if(on) {
        led_set(LED_4, LED_ORANGE_R, LED_ORANGE_G, LED_ORANGE_B, -1);
    } else {
        led_set(LED_4, LED_OFF_R, LED_OFF_G, LED_OFF_B, -1);
    }
}

/**
 * update_led_feedback - Update LED based on active feature count
 *
 * Called every frame from main loop.
 * Skip if menu open (menu controls LED).
 */
function update_led_feedback() {
    if(menu_state == MENU_OPEN) return;

    // Count active features
    int count = 0;
    for(i = 0; i < TOTAL_FEATURES; i++) {
        if(feat_active[i]) count++;
    }

    // Set LED based on count
    if(count == 0) {
        set_led_ready();
    } else if(count == 1) {
        set_led_active_one();
    } else if(count == 2) {
        set_led_active_two();
    } else {
        // Blink for 3+
        led_timer += get_rtime();
        if(led_timer >= TIMING_LED_BLINK) {
            led_state = !led_state;
            set_led_active_many(led_state);
            led_timer = 0;
        }
    }
}

//=============================================================================
// SECTION 13: PERSISTENT MEMORY MANAGEMENT
//=============================================================================

/**
 * init_default_config - Initialize all settings to defaults
 *
 * Called on first run when persistent memory is empty.
 * Sets up reasonable defaults for all features and parameters.
 */
function init_default_config() {
    // Feature enables (Anti-Recoil and Auto Sprint ON by default)
    feat_enabled[FEAT_ANTIRECOIL] = TRUE;
    feat_enabled[FEAT_MOVEREST] = FALSE;
    feat_enabled[FEAT_SNAKING] = FALSE;
    feat_enabled[FEAT_WALLBOUNCE] = FALSE;
    feat_enabled[FEAT_DROPMSHOT] = FALSE;
    feat_enabled[FEAT_BUNNYHOP] = FALSE;
    feat_enabled[FEAT_WEAPSWAP] = FALSE;
    feat_enabled[FEAT_AUTOSPRINT] = TRUE;

    // Activation modes
    feat_mode[FEAT_ANTIRECOIL] = MODE_HOLD;
    feat_mode[FEAT_MOVEREST] = MODE_HOLD;
    feat_mode[FEAT_SNAKING] = MODE_TOGGLE;
    feat_mode[FEAT_WALLBOUNCE] = MODE_HOLD;
    feat_mode[FEAT_DROPMSHOT] = MODE_HOLD;
    feat_mode[FEAT_BUNNYHOP] = MODE_HOLD;
    feat_mode[FEAT_WEAPSWAP] = MODE_HOLD;
    feat_mode[FEAT_AUTOSPRINT] = MODE_HOLD;

    // Primary keys
    feat_key_primary[FEAT_ANTIRECOIL] = KEY_RT;
    feat_key_primary[FEAT_MOVEREST] = KEY_RB;
    feat_key_primary[FEAT_SNAKING] = KEY_LB;
    feat_key_primary[FEAT_WALLBOUNCE] = KEY_X;
    feat_key_primary[FEAT_DROPMSHOT] = KEY_RT;
    feat_key_primary[FEAT_BUNNYHOP] = KEY_L3;
    feat_key_primary[FEAT_WEAPSWAP] = KEY_Y;
    feat_key_primary[FEAT_AUTOSPRINT] = KEY_NONE;

    // Secondary keys
    feat_key_secondary[FEAT_ANTIRECOIL] = KEY_NONE;
    feat_key_secondary[FEAT_MOVEREST] = KEY_NONE;
    feat_key_secondary[FEAT_SNAKING] = KEY_NONE;
    feat_key_secondary[FEAT_WALLBOUNCE] = KEY_NONE;
    feat_key_secondary[FEAT_DROPMSHOT] = KEY_B;
    feat_key_secondary[FEAT_BUNNYHOP] = KEY_NONE;
    feat_key_secondary[FEAT_WEAPSWAP] = KEY_NONE;
    feat_key_secondary[FEAT_AUTOSPRINT] = KEY_NONE;

    // Configuration parameters
    cfg_recoil_vertical = RECOIL_VERT_DEFAULT;
    cfg_recoil_horizontal = RECOIL_HORIZ_DEFAULT;
    cfg_recoil_rate = RECOIL_RATE_DEFAULT;
    cfg_moverest_sprint_time = MOVEREST_SPRINT_DEFAULT;
    cfg_moverest_cancel_time = MOVEREST_CANCEL_DEFAULT;
    cfg_snaking_cycle_time = SNAKING_CYCLE_DEFAULT;
    cfg_wallbounce_jump_time = WALLBOUNCE_JUMP_DEFAULT;
    cfg_wallbounce_delay_time = WALLBOUNCE_DELAY_DEFAULT;
    cfg_dropshot_prone_time = DROPSHOT_PRONE_DEFAULT;
    cfg_bunnyhop_jump_time = BUNNYHOP_JUMP_DEFAULT;
    cfg_bunnyhop_interval = BUNNYHOP_INTERVAL_DEFAULT;
    cfg_weapswap_press_time = WEAPSWAP_PRESS_DEFAULT;
    cfg_weapswap_interval = WEAPSWAP_INTERVAL_DEFAULT;
    cfg_autosprint_threshold = AUTOSPRINT_THRESHOLD_DEFAULT;
    cfg_autosprint_delay = AUTOSPRINT_DELAY_DEFAULT;

    // Menu
    menu_max_index = MENU_MAX_INDEX;  // Highest valid index (0-35)
}

/**
 * save_config - Save all settings to persistent memory
 *
 * Called when menu is closed or settings changed.
 * Stores all feature states and parameters for next boot.
 */
function save_config() {
    // Save feature enables
    for(i = 0; i < TOTAL_FEATURES; i++) {
        pmem_write(PMEM_FEAT_START + i, feat_enabled[i]);
    }

    // Save activation modes
    for(i = 0; i < TOTAL_FEATURES; i++) {
        pmem_write(PMEM_MODE_START + i, feat_mode[i]);
    }

    // Save primary keys
    for(i = 0; i < TOTAL_FEATURES; i++) {
        pmem_write(PMEM_KEY1_START + i, feat_key_primary[i]);
    }

    // Save secondary keys
    for(i = 0; i < TOTAL_FEATURES; i++) {
        pmem_write(PMEM_KEY2_START + i, feat_key_secondary[i]);
    }

    // Save configuration parameters
    pmem_write(PMEM_RECOIL_VERT, cfg_recoil_vertical);
    pmem_write(PMEM_RECOIL_HORIZ, cfg_recoil_horizontal);
    pmem_write(PMEM_MOVEREST_SPR, cfg_moverest_sprint_time);
    pmem_write(PMEM_MOVEREST_CAN, cfg_moverest_cancel_time);
    pmem_write(PMEM_SNAKING_CYC, cfg_snaking_cycle_time);
    pmem_write(PMEM_WALLBOUNCE_J, cfg_wallbounce_jump_time);
    pmem_write(PMEM_WALLBOUNCE_D, cfg_wallbounce_delay_time);
    pmem_write(PMEM_DROPSHOT_P, cfg_dropshot_prone_time);
    pmem_write(PMEM_BUNNYHOP_J, cfg_bunnyhop_jump_time);
    pmem_write(PMEM_BUNNYHOP_I, cfg_bunnyhop_interval);
    pmem_write(PMEM_WEAPSWAP_P, cfg_weapswap_press_time);
    pmem_write(PMEM_WEAPSWAP_I, cfg_weapswap_interval);
    pmem_write(PMEM_AUTOSPRINT_T, cfg_autosprint_threshold);
    pmem_write(PMEM_AUTOSPRINT_D, cfg_autosprint_delay);
}

/**
 * load_config - Load all settings from persistent memory
 *
 * Called during init if persistent memory is initialized.
 * Restores all saved feature states and parameters.
 */
function load_config() {
    // Load feature enables
    for(i = 0; i < TOTAL_FEATURES; i++) {
        feat_enabled[i] = pmem_read(PMEM_FEAT_START + i);
    }

    // Load activation modes
    for(i = 0; i < TOTAL_FEATURES; i++) {
        feat_mode[i] = pmem_read(PMEM_MODE_START + i);
    }

    // Load primary keys
    for(i = 0; i < TOTAL_FEATURES; i++) {
        feat_key_primary[i] = pmem_read(PMEM_KEY1_START + i);
    }

    // Load secondary keys
    for(i = 0; i < TOTAL_FEATURES; i++) {
        feat_key_secondary[i] = pmem_read(PMEM_KEY2_START + i);
    }

    // Load configuration parameters
    cfg_recoil_vertical = pmem_read(PMEM_RECOIL_VERT);
    cfg_recoil_horizontal = pmem_read(PMEM_RECOIL_HORIZ);
    cfg_moverest_sprint_time = pmem_read(PMEM_MOVEREST_SPR);
    cfg_moverest_cancel_time = pmem_read(PMEM_MOVEREST_CAN);
    cfg_snaking_cycle_time = pmem_read(PMEM_SNAKING_CYC);
    cfg_wallbounce_jump_time = pmem_read(PMEM_WALLBOUNCE_J);
    cfg_wallbounce_delay_time = pmem_read(PMEM_WALLBOUNCE_D);
    cfg_dropshot_prone_time = pmem_read(PMEM_DROPSHOT_P);
    cfg_bunnyhop_jump_time = pmem_read(PMEM_BUNNYHOP_J);
    cfg_bunnyhop_interval = pmem_read(PMEM_BUNNYHOP_I);
    cfg_weapswap_press_time = pmem_read(PMEM_WEAPSWAP_P);
    cfg_weapswap_interval = pmem_read(PMEM_WEAPSWAP_I);
    cfg_autosprint_threshold = pmem_read(PMEM_AUTOSPRINT_T);
    cfg_autosprint_delay = pmem_read(PMEM_AUTOSPRINT_D);

    // Restore default rate (not saved)
    cfg_recoil_rate = RECOIL_RATE_DEFAULT;

    // Set menu max
    menu_max_index = MENU_MAX_INDEX;
}

