/*
================================================================================
  FPS PRO MODULAR SCRIPT v9.1
  Advanced First-Person Shooter Controller Enhancement Script
  Cronus Zen GPC - Optimized for Xbox Controller on PC (1000Hz)
================================================================================

  FEATURES:
  ✓ Anti-Recoil (Vertical/Horizontal Compensation)
  ✓ Movement Reset (Slide Cancel)
  ✓ Prone Cycling (Snaking)
  ✓ Wall Bounce (Jump Cancel)
  ✓ Instant Drop Action
  ✓ Bunny Hop (Auto Jump)
  ✓ Rapid Weapon Swap (YY)
  ✓ Auto Sprint
  ✓ Real-Time Configuration Menu
  ✓ Persistent Memory Storage
  ✓ LED Feedback System
  ✓ Feature Conflict Management

  ACTIVATION:
  - Press SELECT + DPAD_UP to open configuration menu
  - All features individually toggleable with custom activation modes

================================================================================
*/

// PERFORMANCE OPTIMIZATION
int vm_timing = 0; // Minimize input delay for 1000Hz polling

//=============================================================================
// SECTION 1: CONSTANT DEFINITIONS
//=============================================================================

// Button Mappings
define BUTTON_LAYOUT_XBOX = TRUE;

// Face Buttons
define A_BUTTON          = XB1_A;
define B_BUTTON          = XB1_B;
define X_BUTTON          = XB1_X;
define Y_BUTTON          = XB1_Y;

// Bumpers & Triggers
define LB                = XB1_LB;
define RB                = XB1_RB;
define LT                = XB1_LT;
define RT                = XB1_RT;

// D-Pad
define DPAD_UP           = XB1_UP;
define DPAD_DOWN         = XB1_DOWN;
define DPAD_LEFT         = XB1_LEFT;
define DPAD_RIGHT        = XB1_RIGHT;

// System Buttons
define SELECT            = XB1_VIEW;
define START             = XB1_MENU;
define L3                = XB1_LS;
define R3                = XB1_RS;

// Analog Sticks
define STICK_LX          = XB1_LX;
define STICK_LY          = XB1_LY;
define STICK_RX          = XB1_RX;
define STICK_RY          = XB1_RY;

// Feature Indices
define FEAT_ANTIRECOIL   = 0;
define FEAT_MOVEREST     = 1;
define FEAT_SNAKING      = 2;
define FEAT_WALLBOUNCE   = 3;
define FEAT_DROPMSHOT    = 4;
define FEAT_BUNNYHOP     = 5;
define FEAT_WEAPSWAP     = 6;
define FEAT_AUTOSPRINT   = 7;
define TOTAL_FEATURES    = 8;

// Activation Modes
define MODE_HOLD         = 0;
define MODE_TOGGLE       = 1;
define MODE_LONGPRESS    = 2;
define MODE_CONDITIONAL  = 3;

// Key Indices for Dropdown
define KEY_RT            = 0;
define KEY_LT            = 1;
define KEY_RB            = 2;
define KEY_LB            = 3;
define KEY_A             = 4;
define KEY_B             = 5;
define KEY_X             = 6;
define KEY_Y             = 7;
define KEY_L3            = 8;
define KEY_R3            = 9;
define KEY_NONE          = 10;

// Menu States
define MENU_CLOSED       = 0;
define MENU_OPEN         = 1;

// Timing Constants
define LONG_PRESS_TIME   = 500;   // ms for long press detection
define MENU_NAV_DELAY    = 150;   // ms between menu navigation inputs
define LED_BLINK_TIME    = 200;   // ms for LED feedback

// Persistent Memory Slots (0-79 available)
define PMEM_INITIALIZED  = 0;
define PMEM_FEAT_START   = 1;  // Slots 1-8: Feature enables
define PMEM_MODE_START   = 9;  // Slots 9-16: Activation modes
define PMEM_KEY1_START   = 17; // Slots 17-24: Primary keys
define PMEM_KEY2_START   = 25; // Slots 25-32: Secondary keys
define PMEM_DELAY_START  = 33; // Slots 33-40: Timing delays
define PMEM_PARAM_START  = 41; // Slots 41-48: Additional parameters

//=============================================================================
// SECTION 2: VARIABLE DECLARATIONS
//=============================================================================

// Feature Control Arrays
int feature_enabled[TOTAL_FEATURES];
int activation_mode[TOTAL_FEATURES];
int key_primary[TOTAL_FEATURES];
int key_secondary[TOTAL_FEATURES];
int feature_active[TOTAL_FEATURES];
int feature_toggle_state[TOTAL_FEATURES];

// Timing Arrays
int feature_timer[TOTAL_FEATURES];
int feature_delay[TOTAL_FEATURES];

// Anti-Recoil Parameters
int recoil_vertical = 25;        // Default vertical compensation (0-100)
int recoil_horizontal = 5;       // Default horizontal compensation (0-100)
int recoil_adjustment_rate = 18; // Speed of compensation application

// Movement Reset Parameters
int movreset_sprint_time = 80;   // Sprint duration
int movreset_cancel_time = 120;  // Cancel animation time
int movreset_step = 0;

// Snaking Parameters
int snaking_cycle_time = 150;    // Time between stance changes
int snaking_step = 0;

// Wall Bounce Parameters
int wallbounce_jump_time = 100;  // Jump hold duration
int wallbounce_delay_time = 150; // Delay between jumps
int wallbounce_step = 0;

// Drop Shot Parameters
int dropshot_prone_time = 80;    // Prone activation time

// Bunny Hop Parameters
int bunnyhop_jump_time = 50;     // Jump tap duration
int bunnyhop_interval = 100;     // Time between jumps

// Weapon Swap Parameters
int weapswap_press_time = 60;    // Y button press duration
int weapswap_interval = 120;     // Time between swaps
int weapswap_count = 0;

// Auto Sprint Parameters
int autosprint_threshold = 60;   // Stick threshold to activate
int autosprint_delay = 100;      // Delay before sprint activates

// Menu System Variables
int menu_state = MENU_CLOSED;
int menu_index = 0;
int menu_subindex = 0;
int menu_max_index = 23;         // Total menu items
int menu_nav_timer = 0;
int menu_select_timer = 0;

// General Timers
int long_press_timer = 0;
int led_timer = 0;
int led_state = 0;

// Utility Variables
int i; // Loop counter
int temp_val;

//=============================================================================
// SECTION 3: INITIALIZATION
//=============================================================================

init {
    // Check if persistent memory is initialized
    if(pmem_read(PMEM_INITIALIZED) != 42) {
        // First run - initialize with defaults
        init_default_settings();
        pmem_write(PMEM_INITIALIZED, 42);
        save_all_settings();
    } else {
        // Load saved settings
        load_all_settings();
    }

    // Initialize feature states
    for(i = 0; i < TOTAL_FEATURES; i++) {
        feature_active[i] = FALSE;
        feature_toggle_state[i] = FALSE;
        feature_timer[i] = 0;
    }

    // Set default LED color (Blue = Ready)
    led_set(LED_4, 0, 100, 0, -1);
}

//=============================================================================
// SECTION 4: MAIN LOOP
//=============================================================================

main {
    // Menu Activation Check (SELECT + DPAD_UP)
    if(event_release(SELECT) && check_active(DPAD_UP, 300)) {
        toggle_menu();
    }

    // Process Menu or Game Logic
    if(menu_state == MENU_OPEN) {
        process_menu();
    } else {
        process_game_features();
    }

    // LED Feedback System
    update_led_feedback();
}

//=============================================================================
// SECTION 5: FEATURE PROCESSING
//=============================================================================

function process_game_features() {
    // Check activation for each feature
    for(i = 0; i < TOTAL_FEATURES; i++) {
        if(feature_enabled[i]) {
            check_feature_activation(i);
        }
    }

    // Execute active features
    if(feature_active[FEAT_ANTIRECOIL]) {
        execute_anti_recoil();
    }

    if(feature_active[FEAT_MOVEREST]) {
        execute_movement_reset();
    }

    if(feature_active[FEAT_SNAKING]) {
        execute_snaking();
    }

    if(feature_active[FEAT_WALLBOUNCE]) {
        execute_wall_bounce();
    }

    if(feature_active[FEAT_DROPMSHOT]) {
        execute_drop_shot();
    }

    if(feature_active[FEAT_BUNNYHOP]) {
        execute_bunny_hop();
    }

    if(feature_active[FEAT_WEAPSWAP]) {
        execute_weapon_swap();
    }

    if(feature_active[FEAT_AUTOSPRINT]) {
        execute_auto_sprint();
    }
}

//=============================================================================
// SECTION 6: FEATURE ACTIVATION LOGIC
//=============================================================================

function check_feature_activation(int feat_idx) {
    int key1_pressed = is_key_pressed(key_primary[feat_idx]);
    int key2_pressed = TRUE;

    // Check secondary key if defined
    if(key_secondary[feat_idx] != KEY_NONE) {
        key2_pressed = is_key_pressed(key_secondary[feat_idx]);
    }

    // Activation mode logic
    if(activation_mode[feat_idx] == MODE_HOLD) {
        // Simple hold mode
        feature_active[feat_idx] = (key1_pressed && key2_pressed);

    } else if(activation_mode[feat_idx] == MODE_TOGGLE) {
        // Toggle mode
        if(key1_pressed && key2_pressed) {
            if(feature_timer[feat_idx] == 0) {
                feature_toggle_state[feat_idx] = !feature_toggle_state[feat_idx];
                feature_timer[feat_idx] = 300; // Debounce
            }
        }
        feature_active[feat_idx] = feature_toggle_state[feat_idx];

    } else if(activation_mode[feat_idx] == MODE_LONGPRESS) {
        // Long press mode
        if(key1_pressed && key2_pressed) {
            if(feature_timer[feat_idx] < LONG_PRESS_TIME) {
                feature_timer[feat_idx] += get_rtime();
            } else {
                feature_active[feat_idx] = TRUE;
            }
        } else {
            feature_timer[feat_idx] = 0;
            feature_active[feat_idx] = FALSE;
        }

    } else if(activation_mode[feat_idx] == MODE_CONDITIONAL) {
        // Conditional mode (e.g., only when ADS)
        int ads_active = get_val(LT) > 50;
        feature_active[feat_idx] = (key1_pressed && key2_pressed && ads_active);
    }

    // Decrement timer if active
    if(feature_timer[feat_idx] > 0) {
        feature_timer[feat_idx] -= get_rtime();
        if(feature_timer[feat_idx] < 0) feature_timer[feat_idx] = 0;
    }
}

function is_key_pressed(int key_idx) {
    if(key_idx == KEY_RT) return get_val(RT) > 50;
    if(key_idx == KEY_LT) return get_val(LT) > 50;
    if(key_idx == KEY_RB) return get_val(RB);
    if(key_idx == KEY_LB) return get_val(LB);
    if(key_idx == KEY_A) return get_val(A_BUTTON);
    if(key_idx == KEY_B) return get_val(B_BUTTON);
    if(key_idx == KEY_X) return get_val(X_BUTTON);
    if(key_idx == KEY_Y) return get_val(Y_BUTTON);
    if(key_idx == KEY_L3) return get_val(L3);
    if(key_idx == KEY_R3) return get_val(R3);
    return FALSE;
}

//=============================================================================
// SECTION 7: FEATURE IMPLEMENTATIONS
//=============================================================================

// -------------------------
// 1. ANTI-RECOIL
// -------------------------
function execute_anti_recoil() {
    // Apply vertical recoil compensation
    if(recoil_vertical > 0) {
        temp_val = get_val(STICK_RY);
        temp_val += recoil_vertical * recoil_adjustment_rate / 100;
        if(temp_val > 100) temp_val = 100;
        set_val(STICK_RY, temp_val);
    }

    // Apply horizontal recoil compensation (if enabled)
    if(recoil_horizontal != 0) {
        temp_val = get_val(STICK_RX);
        temp_val += recoil_horizontal * recoil_adjustment_rate / 100;
        if(temp_val > 100) temp_val = 100;
        if(temp_val < -100) temp_val = -100;
        set_val(STICK_RX, temp_val);
    }
}

// -------------------------
// 2. MOVEMENT RESET (Slide Cancel)
// -------------------------
function execute_movement_reset() {
    if(movreset_step == 0) {
        // Step 1: Activate sprint (L3)
        set_val(L3, 100);
        movreset_step = 1;
        feature_timer[FEAT_MOVEREST] = movreset_sprint_time;

    } else if(movreset_step == 1) {
        if(feature_timer[FEAT_MOVEREST] <= 0) {
            // Step 2: Crouch to cancel
            combo_run(MovementResetCombo);
            movreset_step = 2;
            feature_timer[FEAT_MOVEREST] = movreset_cancel_time;
        }

    } else if(movreset_step == 2) {
        if(feature_timer[FEAT_MOVEREST] <= 0) {
            // Reset and deactivate
            movreset_step = 0;
            feature_active[FEAT_MOVEREST] = FALSE;
            if(activation_mode[FEAT_MOVEREST] == MODE_TOGGLE) {
                feature_toggle_state[FEAT_MOVEREST] = FALSE;
            }
        }
    }
}

// -------------------------
// 3. PRONE CYCLING (Snaking)
// -------------------------
function execute_snaking() {
    if(feature_timer[FEAT_SNAKING] <= 0) {
        if(snaking_step == 0) {
            // Crouch
            combo_run(SnakingCrouch);
            snaking_step = 1;
        } else if(snaking_step == 1) {
            // Prone
            combo_run(SnakingProne);
            snaking_step = 2;
        } else {
            // Stand
            combo_run(SnakingStand);
            snaking_step = 0;
        }
        feature_timer[FEAT_SNAKING] = snaking_cycle_time;
    }
}

// -------------------------
// 4. WALL BOUNCE (Jump Cancel)
// -------------------------
function execute_wall_bounce() {
    if(wallbounce_step == 0) {
        // Jump press
        set_val(A_BUTTON, 100);
        wallbounce_step = 1;
        feature_timer[FEAT_WALLBOUNCE] = wallbounce_jump_time;

    } else if(wallbounce_step == 1) {
        if(feature_timer[FEAT_WALLBOUNCE] <= 0) {
            // Release jump
            set_val(A_BUTTON, 0);
            wallbounce_step = 2;
            feature_timer[FEAT_WALLBOUNCE] = wallbounce_delay_time;
        }

    } else if(wallbounce_step == 2) {
        if(feature_timer[FEAT_WALLBOUNCE] <= 0) {
            // Reset cycle
            wallbounce_step = 0;
            feature_active[FEAT_WALLBOUNCE] = FALSE;
            if(activation_mode[FEAT_WALLBOUNCE] == MODE_TOGGLE) {
                feature_toggle_state[FEAT_WALLBOUNCE] = FALSE;
            }
        }
    }
}

// -------------------------
// 5. DROP SHOT (Instant Prone)
// -------------------------
function execute_drop_shot() {
    combo_run(DropShotCombo);
    wait(dropshot_prone_time);
    feature_active[FEAT_DROPMSHOT] = FALSE;
    if(activation_mode[FEAT_DROPMSHOT] == MODE_TOGGLE) {
        feature_toggle_state[FEAT_DROPMSHOT] = FALSE;
    }
}

// -------------------------
// 6. BUNNY HOP (Auto Jump)
// -------------------------
function execute_bunny_hop() {
    // Check if player is moving
    if(abs(get_val(STICK_LY)) > 30 || abs(get_val(STICK_LX)) > 30) {
        if(feature_timer[FEAT_BUNNYHOP] <= 0) {
            combo_run(BunnyHopCombo);
            feature_timer[FEAT_BUNNYHOP] = bunnyhop_interval;
        }
    }
}

// -------------------------
// 7. WEAPON SWAP (YY)
// -------------------------
function execute_weapon_swap() {
    if(weapswap_count == 0) {
        combo_run(WeaponSwapCombo);
        weapswap_count = 1;
        feature_timer[FEAT_WEAPSWAP] = weapswap_interval;
    } else if(weapswap_count == 1 && feature_timer[FEAT_WEAPSWAP] <= 0) {
        combo_run(WeaponSwapCombo);
        weapswap_count = 0;
        feature_active[FEAT_WEAPSWAP] = FALSE;
        if(activation_mode[FEAT_WEAPSWAP] == MODE_TOGGLE) {
            feature_toggle_state[FEAT_WEAPSWAP] = FALSE;
        }
    }
}

// -------------------------
// 8. AUTO SPRINT
// -------------------------
function execute_auto_sprint() {
    // Check forward movement threshold
    if(get_val(STICK_LY) < -autosprint_threshold) {
        if(feature_timer[FEAT_AUTOSPRINT] <= 0) {
            set_val(L3, 100);
            feature_timer[FEAT_AUTOSPRINT] = autosprint_delay;
        }
    } else {
        feature_timer[FEAT_AUTOSPRINT] = 0;
    }
}

//=============================================================================
// SECTION 8: COMBO DEFINITIONS
//=============================================================================

combo MovementResetCombo {
    set_val(B_BUTTON, 100);  // Crouch
    wait(60);
    set_val(B_BUTTON, 0);
    wait(60);
    set_val(B_BUTTON, 100);  // Double tap
    wait(60);
    set_val(B_BUTTON, 0);
}

combo SnakingCrouch {
    set_val(B_BUTTON, 100);
    wait(50);
    set_val(B_BUTTON, 0);
}

combo SnakingProne {
    set_val(B_BUTTON, 100);
    wait(50);
    set_val(B_BUTTON, 0);
    wait(50);
    set_val(B_BUTTON, 100);
    wait(50);
    set_val(B_BUTTON, 0);
}

combo SnakingStand {
    set_val(B_BUTTON, 100);
    wait(50);
    set_val(B_BUTTON, 0);
}

combo DropShotCombo {
    set_val(B_BUTTON, 100);
    wait(40);
    set_val(B_BUTTON, 0);
    wait(40);
    set_val(B_BUTTON, 100);
    wait(40);
    set_val(B_BUTTON, 0);
}

combo BunnyHopCombo {
    set_val(A_BUTTON, 100);
    wait(bunnyhop_jump_time);
    set_val(A_BUTTON, 0);
}

combo WeaponSwapCombo {
    set_val(Y_BUTTON, 100);
    wait(weapswap_press_time);
    set_val(Y_BUTTON, 0);
}

//=============================================================================
// SECTION 9: MENU SYSTEM
//=============================================================================

function toggle_menu() {
    if(menu_state == MENU_CLOSED) {
        menu_state = MENU_OPEN;
        menu_index = 0;
        menu_subindex = 0;
        led_set(LED_4, 100, 100, 0, -1); // Yellow = Menu Open
    } else {
        menu_state = MENU_CLOSED;
        save_all_settings();
        led_set(LED_4, 0, 100, 0, -1); // Blue = Ready
    }
}

function process_menu() {
    // Navigation with D-Pad
    if(menu_nav_timer <= 0) {
        if(get_val(DPAD_DOWN)) {
            menu_index++;
            if(menu_index > menu_max_index) menu_index = 0;
            menu_nav_timer = MENU_NAV_DELAY;
        }

        if(get_val(DPAD_UP)) {
            menu_index--;
            if(menu_index < 0) menu_index = menu_max_index;
            menu_nav_timer = MENU_NAV_DELAY;
        }

        if(get_val(DPAD_LEFT)) {
            adjust_menu_value(-1);
            menu_nav_timer = MENU_NAV_DELAY;
        }

        if(get_val(DPAD_RIGHT)) {
            adjust_menu_value(1);
            menu_nav_timer = MENU_NAV_DELAY;
        }
    } else {
        menu_nav_timer -= get_rtime();
        if(menu_nav_timer < 0) menu_nav_timer = 0;
    }

    // Exit menu with SELECT
    if(event_release(SELECT)) {
        toggle_menu();
    }
}

function adjust_menu_value(int direction) {
    // Anti-Recoil Options (Indices 0-4)
    if(menu_index == 0) {
        feature_enabled[FEAT_ANTIRECOIL] = !feature_enabled[FEAT_ANTIRECOIL];
    } else if(menu_index == 1) {
        activation_mode[FEAT_ANTIRECOIL] = cycle_value(activation_mode[FEAT_ANTIRECOIL], 0, 3, direction);
    } else if(menu_index == 2) {
        key_primary[FEAT_ANTIRECOIL] = cycle_value(key_primary[FEAT_ANTIRECOIL], 0, 10, direction);
    } else if(menu_index == 3) {
        recoil_vertical = clamp_value(recoil_vertical + (direction * 5), 0, 100);
    } else if(menu_index == 4) {
        recoil_horizontal = clamp_value(recoil_horizontal + direction, -20, 20);
    }

    // Movement Reset Options (Indices 5-7)
    else if(menu_index == 5) {
        feature_enabled[FEAT_MOVEREST] = !feature_enabled[FEAT_MOVEREST];
    } else if(menu_index == 6) {
        activation_mode[FEAT_MOVEREST] = cycle_value(activation_mode[FEAT_MOVEREST], 0, 3, direction);
    } else if(menu_index == 7) {
        key_primary[FEAT_MOVEREST] = cycle_value(key_primary[FEAT_MOVEREST], 0, 10, direction);
    }

    // Snaking Options (Indices 8-10)
    else if(menu_index == 8) {
        feature_enabled[FEAT_SNAKING] = !feature_enabled[FEAT_SNAKING];
    } else if(menu_index == 9) {
        activation_mode[FEAT_SNAKING] = cycle_value(activation_mode[FEAT_SNAKING], 0, 3, direction);
    } else if(menu_index == 10) {
        key_primary[FEAT_SNAKING] = cycle_value(key_primary[FEAT_SNAKING], 0, 10, direction);
    }

    // Wall Bounce Options (Indices 11-13)
    else if(menu_index == 11) {
        feature_enabled[FEAT_WALLBOUNCE] = !feature_enabled[FEAT_WALLBOUNCE];
    } else if(menu_index == 12) {
        activation_mode[FEAT_WALLBOUNCE] = cycle_value(activation_mode[FEAT_WALLBOUNCE], 0, 3, direction);
    } else if(menu_index == 13) {
        key_primary[FEAT_WALLBOUNCE] = cycle_value(key_primary[FEAT_WALLBOUNCE], 0, 10, direction);
    }

    // Drop Shot Options (Indices 14-16)
    else if(menu_index == 14) {
        feature_enabled[FEAT_DROPMSHOT] = !feature_enabled[FEAT_DROPMSHOT];
    } else if(menu_index == 15) {
        activation_mode[FEAT_DROPMSHOT] = cycle_value(activation_mode[FEAT_DROPMSHOT], 0, 3, direction);
    } else if(menu_index == 16) {
        key_primary[FEAT_DROPMSHOT] = cycle_value(key_primary[FEAT_DROPMSHOT], 0, 10, direction);
    }

    // Bunny Hop Options (Indices 17-19)
    else if(menu_index == 17) {
        feature_enabled[FEAT_BUNNYHOP] = !feature_enabled[FEAT_BUNNYHOP];
    } else if(menu_index == 18) {
        activation_mode[FEAT_BUNNYHOP] = cycle_value(activation_mode[FEAT_BUNNYHOP], 0, 3, direction);
    } else if(menu_index == 19) {
        bunnyhop_interval = clamp_value(bunnyhop_interval + (direction * 10), 50, 300);
    }

    // Weapon Swap Options (Indices 20-21)
    else if(menu_index == 20) {
        feature_enabled[FEAT_WEAPSWAP] = !feature_enabled[FEAT_WEAPSWAP];
    } else if(menu_index == 21) {
        key_primary[FEAT_WEAPSWAP] = cycle_value(key_primary[FEAT_WEAPSWAP], 0, 10, direction);
    }

    // Auto Sprint Options (Indices 22-23)
    else if(menu_index == 22) {
        feature_enabled[FEAT_AUTOSPRINT] = !feature_enabled[FEAT_AUTOSPRINT];
    } else if(menu_index == 23) {
        autosprint_threshold = clamp_value(autosprint_threshold + (direction * 10), 30, 90);
    }
}

//=============================================================================
// SECTION 10: UTILITY FUNCTIONS
//=============================================================================

function cycle_value(int current, int min_val, int max_val, int direction) {
    current += direction;
    if(current > max_val) current = min_val;
    if(current < min_val) current = max_val;
    return current;
}

function clamp_value(int value, int min_val, int max_val) {
    if(value < min_val) return min_val;
    if(value > max_val) return max_val;
    return value;
}

function check_active(int button, int time_ms) {
    return get_ptime(button) >= time_ms;
}

//=============================================================================
// SECTION 11: LED FEEDBACK SYSTEM
//=============================================================================

function update_led_feedback() {
    // Skip if menu is open
    if(menu_state == MENU_OPEN) return;

    // Count active features
    int active_count = 0;
    for(i = 0; i < TOTAL_FEATURES; i++) {
        if(feature_active[i]) active_count++;
    }

    // Set LED based on active features
    if(active_count == 0) {
        led_set(LED_4, 0, 100, 0, -1); // Blue = Ready
    } else if(active_count == 1) {
        led_set(LED_4, 0, 100, 100, -1); // Cyan = 1 Active
    } else if(active_count == 2) {
        led_set(LED_4, 0, 0, 100, -1); // Green = 2 Active
    } else {
        // Blink orange for 3+ features
        led_timer += get_rtime();
        if(led_timer >= LED_BLINK_TIME) {
            led_state = !led_state;
            if(led_state) {
                led_set(LED_4, 50, 100, 0, -1); // Orange
            } else {
                led_set(LED_4, 0, 0, 0, -1); // Off
            }
            led_timer = 0;
        }
    }
}

//=============================================================================
// SECTION 12: PERSISTENT MEMORY MANAGEMENT
//=============================================================================

function init_default_settings() {
    // Default: Anti-Recoil enabled with RT trigger
    feature_enabled[FEAT_ANTIRECOIL] = TRUE;
    activation_mode[FEAT_ANTIRECOIL] = MODE_HOLD;
    key_primary[FEAT_ANTIRECOIL] = KEY_RT;
    key_secondary[FEAT_ANTIRECOIL] = KEY_NONE;

    // Default: Movement Reset on RB
    feature_enabled[FEAT_MOVEREST] = FALSE;
    activation_mode[FEAT_MOVEREST] = MODE_HOLD;
    key_primary[FEAT_MOVEREST] = KEY_RB;
    key_secondary[FEAT_MOVEREST] = KEY_NONE;

    // Default: Snaking on LB
    feature_enabled[FEAT_SNAKING] = FALSE;
    activation_mode[FEAT_SNAKING] = MODE_TOGGLE;
    key_primary[FEAT_SNAKING] = KEY_LB;
    key_secondary[FEAT_SNAKING] = KEY_NONE;

    // Default: Wall Bounce on X
    feature_enabled[FEAT_WALLBOUNCE] = FALSE;
    activation_mode[FEAT_WALLBOUNCE] = MODE_HOLD;
    key_primary[FEAT_WALLBOUNCE] = KEY_X;
    key_secondary[FEAT_WALLBOUNCE] = KEY_NONE;

    // Default: Drop Shot on RT + B
    feature_enabled[FEAT_DROPMSHOT] = FALSE;
    activation_mode[FEAT_DROPMSHOT] = MODE_HOLD;
    key_primary[FEAT_DROPMSHOT] = KEY_RT;
    key_secondary[FEAT_DROPMSHOT] = KEY_B;

    // Default: Bunny Hop on L3 hold
    feature_enabled[FEAT_BUNNYHOP] = FALSE;
    activation_mode[FEAT_BUNNYHOP] = MODE_HOLD;
    key_primary[FEAT_BUNNYHOP] = KEY_L3;
    key_secondary[FEAT_BUNNYHOP] = KEY_NONE;

    // Default: Weapon Swap on Y double tap
    feature_enabled[FEAT_WEAPSWAP] = FALSE;
    activation_mode[FEAT_WEAPSWAP] = MODE_HOLD;
    key_primary[FEAT_WEAPSWAP] = KEY_Y;
    key_secondary[FEAT_WEAPSWAP] = KEY_NONE;

    // Default: Auto Sprint enabled
    feature_enabled[FEAT_AUTOSPRINT] = TRUE;
    activation_mode[FEAT_AUTOSPRINT] = MODE_HOLD;
    key_primary[FEAT_AUTOSPRINT] = KEY_NONE;
    key_secondary[FEAT_AUTOSPRINT] = KEY_NONE;
}

function save_all_settings() {
    // Save feature enables
    for(i = 0; i < TOTAL_FEATURES; i++) {
        pmem_write(PMEM_FEAT_START + i, feature_enabled[i]);
    }

    // Save activation modes
    for(i = 0; i < TOTAL_FEATURES; i++) {
        pmem_write(PMEM_MODE_START + i, activation_mode[i]);
    }

    // Save primary keys
    for(i = 0; i < TOTAL_FEATURES; i++) {
        pmem_write(PMEM_KEY1_START + i, key_primary[i]);
    }

    // Save secondary keys
    for(i = 0; i < TOTAL_FEATURES; i++) {
        pmem_write(PMEM_KEY2_START + i, key_secondary[i]);
    }

    // Save special parameters
    pmem_write(PMEM_PARAM_START + 0, recoil_vertical);
    pmem_write(PMEM_PARAM_START + 1, recoil_horizontal);
    pmem_write(PMEM_PARAM_START + 2, bunnyhop_interval);
    pmem_write(PMEM_PARAM_START + 3, autosprint_threshold);
}

function load_all_settings() {
    // Load feature enables
    for(i = 0; i < TOTAL_FEATURES; i++) {
        feature_enabled[i] = pmem_read(PMEM_FEAT_START + i);
    }

    // Load activation modes
    for(i = 0; i < TOTAL_FEATURES; i++) {
        activation_mode[i] = pmem_read(PMEM_MODE_START + i);
    }

    // Load primary keys
    for(i = 0; i < TOTAL_FEATURES; i++) {
        key_primary[i] = pmem_read(PMEM_KEY1_START + i);
    }

    // Load secondary keys
    for(i = 0; i < TOTAL_FEATURES; i++) {
        key_secondary[i] = pmem_read(PMEM_KEY2_START + i);
    }

    // Load special parameters
    recoil_vertical = pmem_read(PMEM_PARAM_START + 0);
    recoil_horizontal = pmem_read(PMEM_PARAM_START + 1);
    bunnyhop_interval = pmem_read(PMEM_PARAM_START + 2);
    autosprint_threshold = pmem_read(PMEM_PARAM_START + 3);
}

//=============================================================================
// END OF SCRIPT
//=============================================================================

/*
  USAGE INSTRUCTIONS:

  1. Load this script onto your Cronus Zen device
  2. Connect your Xbox controller and ensure 1000Hz polling is active
  3. Press SELECT + DPAD_UP to open the configuration menu
  4. Use DPAD_UP/DOWN to navigate menu options
  5. Use DPAD_LEFT/RIGHT to adjust values
  6. Press SELECT again to save and close the menu

  DEFAULT KEYBINDINGS:
  - Anti-Recoil: RT (Auto-active when firing)
  - Movement Reset: RB (Slide cancel)
  - Snaking: LB (Toggle)
  - Wall Bounce: X (Hold)
  - Drop Shot: RT + B (Instant prone while shooting)
  - Bunny Hop: L3 (Hold while moving)
  - Weapon Swap: Y (Custom activation)
  - Auto Sprint: Always active (forward movement)

  LED INDICATORS:
  - Blue: Ready (no features active)
  - Cyan: 1 feature active
  - Green: 2 features active
  - Blinking Orange: 3+ features active
  - Yellow: Configuration menu open

  CUSTOMIZATION:
  All timing values can be adjusted in the "VARIABLE DECLARATIONS" section.
  Advanced users can modify combo sequences in the "COMBO DEFINITIONS" section.
*/
